<Project>
    <!-- Spike code (T012), never referenced by a production project. The spike builds the account and gateway test hosts, so it
         takes the application's central versions and adds only the pinned authorization-server candidate. -->
    <Import Project="$(MSBuildThisFileDirectory)../../../application/Directory.Packages.props" />
    <ItemGroup>
        <!-- OpenIddict 7.5.0, Apache-2.0: the newest release whose dependencies fit the application pins (7.6.0 and 7.7.0 need
             Microsoft.Extensions 10.0.10 and 10.0.11, above the central 10.0.9). Checked on nuget.org on 2026-09-15. -->
        <PackageVersion Include="OpenIddict.Server.AspNetCore" Version="7.5.0" />
    </ItemGroup>
</Project>
