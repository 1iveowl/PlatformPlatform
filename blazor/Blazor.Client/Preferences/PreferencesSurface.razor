@* The preferences page, the React edition's user preferences: theme, language and zoom, each applied as soon as it is
   chosen. Theme and zoom level are device preferences: DevicePreferences applies and stores them through the host's
   theme.js, which the shell's user menu shares, reports them as telemetry and a short toast confirms the change. The
   language is saved on the user: LocaleSwitch, which the shell's mobile menu shares, allows one change at a time, and only
   after the account API confirmed it is the choice remembered in the preferred-locale cookie and the page loaded again, so
   the host renders the new culture from the refreshed locale claim. A refused change keeps the current language selected
   and shows the failure as the API returned it; choosing again retries. During prerender the groups render disabled,
   because the device's theme and zoom level are only known in the browser. *@
@using Blazor.Client.Bootstrap
@using Blazor.Client.FeatureFlags
@using Blazor.Client.Session
@implements IDisposable
@inject SessionState Session
@inject DevicePreferences Preferences
@inject IServiceProvider Services
@inject ToastService Toasts
@inject LocaleSwitch Locale

<AppShell SupportEmail="@SupportEmail">
    <h1>@AccountStrings.UserPreferences</h1>
    <p>@AccountStrings.UserPreferencesDescription</p>

    <section class="preferences-section" data-testid="preferences-theme">
        <h2 id="preferences-theme-label">@AccountStrings.Theme</h2>
        <p id="preferences-theme-description" class="preferences-description">@AccountStrings.ThemeDescription</p>
        <ToggleGroup Name="theme" Items="ThemeItems" Value="@(Preferences.IsLoaded ? ThemePreference.Format(Preferences.Theme) : null)"
                     Disabled="!Preferences.IsLoaded" LabelId="preferences-theme-label" DescriptionId="preferences-theme-description"
                     TestId="theme-group" OnChange="OnThemeChangedAsync"/>
    </section>

    <section class="preferences-section" data-testid="preferences-language">
        <h2 id="preferences-language-label">@AccountStrings.Language</h2>
        <p id="preferences-language-description" class="preferences-description">@AccountStrings.LanguageDescription</p>
        <ToggleGroup Name="language" Items="LanguageItems" Value="@Locale.CurrentLocale" Revision="Locale.Revision"
                     Disabled="!_isInteractive || Locale.IsPending" LabelId="preferences-language-label" DescriptionId="preferences-language-description"
                     TestId="language-group" OnChange="locale => Locale.ChangeAsync(locale)"/>
    </section>

    <section class="preferences-section" data-testid="preferences-zoom">
        <h2 id="preferences-zoom-label">@AccountStrings.Zoom</h2>
        <ToggleGroup Name="zoom-level" Items="ZoomItems" Value="@(Preferences.IsLoaded ? Preferences.ZoomLevel : null)" Disabled="!Preferences.IsLoaded"
                     LabelId="preferences-zoom-label" TestId="zoom-group" OnChange="OnZoomLevelChangedAsync"/>
    </section>

    <PushNotificationsSection/>

    <FeatureFlagsSection Scope="FeatureFlagSectionScope.User"/>
</AppShell>

@code {

    public const string ThemeUpdatedToastTestId = "theme-updated-toast";
    public const string ZoomLevelUpdatedToastTestId = "zoom-level-updated-toast";

    private static readonly ToggleGroupItem[] ThemeItems = ThemePreference.Modes
        .Select(mode => new ToggleGroupItem(ThemePreference.Format(mode), ThemeMenu.Label(mode), $"theme-{ThemePreference.Format(mode)}"))
        .ToArray();

    private static readonly ToggleGroupItem[] LanguageItems = LocalePreference.Locales
        .Select(locale => new ToggleGroupItem(locale, LocalePreference.Label(locale), $"language-{locale}"))
        .ToArray();

    private static readonly ToggleGroupItem[] ZoomItems = ZoomPreference.Levels
        .Select(level => new ToggleGroupItem(level, ZoomPreference.Label(level), $"zoom-level-{level}"))
        .ToArray();

    private bool _isInteractive;
    private long? _toastId;

    // The brand's support address, passed on to the shell, whose mobile menu offers it as a mail link
    [Parameter]
    public string? SupportEmail { get; set; }

    public void Dispose()
    {
        Preferences.Changed -= OnPreferencesChanged;
        Locale.Changed -= OnPreferencesChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        Preferences.Changed += OnPreferencesChanged;
        Locale.Changed += OnPreferencesChanged;
        var bootstrap = await Session.GetUnlessLeavingAsync();
        if (bootstrap is null || !RendererInfo.IsInteractive) return;

        if (!bootstrap.IsAuthenticated)
        {
            Services.GetRequiredService<AuthenticationNavigator>().LeaveForLogin();
            return;
        }

        _isInteractive = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && RendererInfo.IsInteractive) await Preferences.LoadAsync();
    }

    private void OnPreferencesChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnThemeChangedAsync(string theme)
    {
        if (await Preferences.ChangeThemeAsync(ThemePreference.Parse(theme))) ShowToast(AccountStrings.ThemeUpdated, ThemeUpdatedToastTestId);
    }

    private async Task OnZoomLevelChangedAsync(string zoomLevel)
    {
        if (await Preferences.ChangeZoomLevelAsync(zoomLevel)) ShowToast(AccountStrings.ZoomLevelUpdated, ZoomLevelUpdatedToastTestId);
    }

    // One confirmation at a time, so repeated changes replace the toast instead of stacking
    private void ShowToast(string title, string testId)
    {
        if (_toastId is { } previous) Toasts.Dismiss(previous);
        _toastId = Toasts.Show(ToastKind.Success, title, null, testId).Id;
    }

}
