@* Spike code (Blazor edition, stage B1): the one interactive WebAssembly component on the page under test *@
@using ApexCharts
@using Microsoft.FluentUI.AspNetCore.Components
@implements IAsyncDisposable
@inject IJSRuntime JavaScriptRuntime

<h1>B1 boot spike</h1>

<p data-testid="signed-in-email">Signed in as @Email</p>

<p data-testid="render-mode">Interactive: @RendererInfo.IsInteractive</p>

<FluentButton Appearance="ButtonAppearance.Primary" OnClick="IncrementCount" data-testid="counter-button">
    Count: <span data-testid="counter-value">@_count</span>
</FluentButton>

<div data-testid="chart">
    <ApexChart TItem="MonthlyValue" Title="Monthly values" Height="240">
        <ApexPointSeries TItem="MonthlyValue" Items="MonthlyValues" Name="Value" SeriesType="SeriesType.Bar" XValue="item => item.Month" YValue="item => item.Value"/>
    </ApexChart>
</div>

@code {

    private static readonly MonthlyValue[] MonthlyValues =
    [
        new("Jan", 12), new("Feb", 19), new("Mar", 7), new("Apr", 15), new("May", 22), new("Jun", 10)
    ];

    private int _count;
    private IJSObjectReference? _interactiveMarkerModule;

    [Parameter]
    public string Email { get; set; } = "";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive) return;

        _interactiveMarkerModule = await JavaScriptRuntime.InvokeAsync<IJSObjectReference>("import", "./js/b1-interactive.js");
        await _interactiveMarkerModule.InvokeVoidAsync("markInteractive");
    }

    private void IncrementCount()
    {
        _count++;
    }

    public async ValueTask DisposeAsync()
    {
        if (_interactiveMarkerModule is not null)
        {
            await _interactiveMarkerModule.DisposeAsync();
        }
    }

    private sealed record MonthlyValue(string Month, decimal Value);

}
