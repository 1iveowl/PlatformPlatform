@* The shell every Blazor back-office page renders inside, the React back office's layout with its side menu: the banner
   region on top, the collapsible sidebar with the back office's navigation and the user menu, the mobile menu below the
   small breakpoint, and the main content with the toasts. It reuses the app shell's layout classes and shell.js for the
   collapsed state and Ctrl+B or Cmd+B, but none of the app's session machinery: the identity is the back-office identity
   the account API reports through BackOfficeClient, read once in the browser, and a 401 leaves through the platform login
   (BackOfficeUnauthorizedHandler). The Billing group and the billing banners follow the back office's subscription setting,
   which the host page passes in from BACK_OFFICE_SUBSCRIPTION_ENABLED. The identity cascades to the page, null until it is
   loaded, so a page offers admin actions from the same read. *@
@using Account.Client
@using Account.Features.BackOffice.Queries
@implements IAsyncDisposable
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject IJSRuntime JavaScriptRuntime

<div class="app-shell" data-testid="back-office-shell" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")" data-sidebar="@(_collapsed ? "collapsed" : "expanded")" data-identity-state="@(_me is null ? "loading" : "loaded")">
    <BannerRegion>
        <BillingBannerList IsSubscriptionEnabled="IsSubscriptionEnabled"/>
        @Banners
    </BannerRegion>

    <aside class="app-sidebar">
        <div class="app-sidebar-header">
            <button type="button" class="app-sidebar-toggle" aria-label="@CommonStrings.ToggleSidebar" aria-expanded="@(_collapsed ? "false" : "true")"
                    aria-controls="app-sidebar-navigation" aria-keyshortcuts="Control+B Meta+B" @onclick="ToggleSidebar">
                <span aria-hidden="true">☰</span>
            </button>
            <span class="app-sidebar-tenant">@BackOfficeStrings.BackOffice</span>
        </div>

        <nav class="app-sidebar-navigation" id="app-sidebar-navigation" aria-label="@CommonStrings.MainNavigation">
            <BackOfficeNavigationLinks Items="NavigationItems" IdPrefix="sidebar-nav"/>
        </nav>

        <div class="app-sidebar-footer">
            @if (RendererInfo.IsInteractive)
            {
                <BackOfficeUserMenu Me="_me" DescribedBy="back-office-user-name"/>
            }
            <span class="app-sidebar-user-name" id="back-office-user-name" data-testid="back-office-user-name">@_me?.DisplayName</span>
        </div>
    </aside>

    @if (RendererInfo.IsInteractive)
    {
        <div class="app-mobile-header">
            <BackOfficeMobileMenu Me="_me" Items="NavigationItems"/>
        </div>
    }

    <main id="main-content" class="app-main" aria-label="@CommonStrings.MainContent">
        <ToastRegion/>

        <CascadingValue Value="_me">
            @ChildContent
        </CascadingValue>
    </main>
</div>

@code {

    private bool _collapsed;
    private DotNetObjectReference<BackOfficeShell>? _dotNet;
    private ShellInterop? _interop;
    private bool _isWide = true;
    private ShellLocationWatcher? _locationWatcher;
    private MeResponse? _me;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // Further banners above the shell, after the billing banners every back-office page shows
    [Parameter]
    public RenderFragment? Banners { get; set; }

    [Parameter]
    public bool IsSubscriptionEnabled { get; set; }

    private IReadOnlyList<BackOfficeNavigationItem> NavigationItems => BackOfficeNavigation.Create(IsSubscriptionEnabled, Navigation.Uri);

    [JSInvokable]
    public async Task ToggleSidebar()
    {
        await InvokeAsync(async () =>
            {
                _collapsed = !_collapsed;
                StateHasChanged();
                if (_interop is not null && ShellSidebarState.ShouldPersist(_isWide)) await _interop.StoreCollapsedAsync(_collapsed);
            }
        );
    }

    [JSInvokable]
    public async Task OnViewportChanged(ShellViewport viewport)
    {
        await InvokeAsync(() =>
            {
                _isWide = viewport.IsWide;
                if (!_isWide) _collapsed = true;
                StateHasChanged();
            }
        );
    }

    public async ValueTask DisposeAsync()
    {
        _locationWatcher?.Dispose();
        if (_interop is not null) await _interop.DisposeAsync();
        _dotNet?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        // Enhanced navigation changes the location without re-rendering a shell that stays alive across it
        _locationWatcher = new ShellLocationWatcher(Navigation, () => _ = InvokeAsync(StateHasChanged));
        if (!RendererInfo.IsInteractive) return;

        // Resolved lazily: the host does not register the back-office client, so prerendering never constructs it
        var result = await Services.GetRequiredService<BackOfficeClient>().GetMeAsync(CancellationToken.None);
        if (result.Outcome == ApiCallOutcome.Unauthorized) return;

        if (!result.IsSuccess)
        {
            Services.GetRequiredService<ApiFailurePresenter>().Present(result);
            return;
        }

        _me = result.Value;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive) return;

        _interop = new ShellInterop(JavaScriptRuntime);
        _dotNet = DotNetObjectReference.Create(this);
        var state = await _interop.AttachShellAsync(_dotNet);
        _isWide = state.IsWide;
        _collapsed = ShellSidebarState.IsCollapsed(state.StoredCollapsed, state.IsWide);
        StateHasChanged();
    }

}
