@using Account.Client
@using Blazor.Client.BackOffice.Shared
@using Account.Features.BackOffice.Dashboard.Queries
@using Blazor.Client.Sessions
@* The recent logins card, from GET /api/back-office/dashboard/recent-logins with the React back office's limit of six rows, and View all to users. *@
@implements IDisposable
@inject IServiceProvider Services

<DashboardCard TestId="recent-logins" Title="@BackOfficeStrings.RecentLogins" ViewAllHref='@BackOfficeUrls.ToAbsolute("users")' IsLoading="_read.IsLoading" IsEmpty="_read.Value?.Length == 0"
               IsFailed="_read.IsFailed" FailureMessage="@_read.FailureMessage" OnRetry="LoadAsync"
               EmptyTitle="@BackOfficeStrings.NoRecentLogins" EmptyDescription="@BackOfficeStrings.NoRecentLoginsDescription">
    <table class="dashboard-table">
        <caption class="visually-hidden">@BackOfficeStrings.RecentLogins</caption>
        <thead>
        <tr>
            <th scope="col">@AccountStrings.User</th>
            <th scope="col" class="dashboard-column-secondary">@AccountStrings.Account</th>
            <th scope="col">@BackOfficeStrings.Method</th>
            <th scope="col" class="dashboard-column-end">@BackOfficeStrings.When</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in _read.Value!)
        {
            <tr data-testid="recent-logins-row">
                <td class="dashboard-cell-primary">@DashboardFormat.GetPersonName(row.FirstName, row.LastName, row.Email)</td>
                <td class="dashboard-column-secondary">@(row.TenantName ?? DashboardFormat.Missing)</td>
                <td>
                    <span class="dashboard-badge">@SessionsModel.GetLoginMethodLabel(row.Method)</span>
                </td>
                <td class="dashboard-column-end dashboard-cell-muted">@RelativeTime.Format(row.OccurredAt, TimeProvider.System.GetUtcNow())</td>
            </tr>
        }
        </tbody>
    </table>
</DashboardCard>

@code {

    private readonly BackOfficeRead<BackOfficeDashboardLogin[]> _read = new();

    public void Dispose()
    {
        _read.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await _read.LoadAsync(
            cancellationToken => Services.GetRequiredService<BackOfficeClient>().GetRecentLoginsAsync(DashboardFormat.RecentLimit, cancellationToken),
            response => response.Logins, Services.GetRequiredService<ApiFailurePresenter>()
        );
    }

}
