@using Blazor.Client.BackOffice.Shared
@* One card of the dashboard, the React back office's DashboardCardShell: the title, the subtitle a chart card states, the
   view-all link a recent activity card has, and the loading text, the failed state with Try again, the empty state or the
   content the card supplies. The link names the card it belongs to through aria-describedby, so four "View all" links stay distinguishable. *@

<section class="dashboard-card" aria-labelledby="@TitleId" data-testid="@TestId" data-state="@State">
    <div class="dashboard-card-header">
        <div>
            <h2 id="@TitleId" class="dashboard-card-title">@Title</h2>
            @if (Subtitle is not null)
            {
                <p class="dashboard-card-subtitle" data-testid="@($"{TestId}-subtitle")">@Subtitle</p>
            }
        </div>
        @if (ViewAllHref is not null)
        {
            <a class="dashboard-card-link" href="@ViewAllHref" aria-describedby="@TitleId" data-testid="@($"{TestId}-view-all")">@BackOfficeStrings.ViewAll</a>
        }
    </div>
    @switch (State)
    {
        case "failed":
            <BackOfficeReadFailure TestId="@($"{TestId}-failed")" Message="@FailureMessage" OnRetry="OnRetry"/>
            break;
        case "loading":
            <p class="dashboard-card-loading" role="status">@CommonStrings.Loading</p>
            break;
        case "empty":
            <div class="dashboard-card-empty" data-testid="@($"{TestId}-empty")">
                <p class="dashboard-card-empty-title">@EmptyTitle</p>
                <p>@EmptyDescription</p>
            </div>
            break;
        default:
            @ChildContent
            break;
    }
</section>

@code {

    private string TitleId => $"{TestId}-title";

    private string State => IsFailed ? "failed" : IsLoading ? "loading" : IsEmpty ? "empty" : "loaded";

    [Parameter]
    [EditorRequired]
    public string TestId { get; set; } = "";

    [Parameter]
    [EditorRequired]
    public string Title { get; set; } = "";

    [Parameter]
    public string? Subtitle { get; set; }

    [Parameter]
    public string? ViewAllHref { get; set; }

    [Parameter]
    public bool IsLoading { get; set; }

    [Parameter]
    public bool IsFailed { get; set; }

    // The presented failure's message, shown in the failed state
    [Parameter]
    public string? FailureMessage { get; set; }

    // Reads the card's data again for the same selection
    [Parameter]
    public EventCallback OnRetry { get; set; }

    [Parameter]
    public bool IsEmpty { get; set; }

    [Parameter]
    public string EmptyTitle { get; set; } = "";

    [Parameter]
    public string EmptyDescription { get; set; } = "";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

}
