@using Account.Client
@using Blazor.Client.BackOffice.Shared
@using Account.Features.BackOffice.Dashboard.Queries
@* The recent signups card, from GET /api/back-office/dashboard/recent-signups with the React back office's limit of six rows, and View all to accounts?orderBy=CreatedAt. *@
@implements IDisposable
@inject IServiceProvider Services

<DashboardCard TestId="recent-signups" Title="@BackOfficeStrings.RecentSignups" ViewAllHref='@BackOfficeUrls.ToAbsolute("accounts?orderBy=CreatedAt")' IsLoading="_read.IsLoading" IsEmpty="_read.Value?.Length == 0"
               IsFailed="_read.IsFailed" FailureMessage="@_read.FailureMessage" OnRetry="LoadAsync"
               EmptyTitle="@BackOfficeStrings.NoRecentSignups" EmptyDescription="@BackOfficeStrings.NoRecentSignupsDescription">
    <table class="dashboard-table">
        <caption class="visually-hidden">@BackOfficeStrings.RecentSignups</caption>
        <thead>
        <tr>
            <th scope="col">@AccountStrings.Account</th>
            <th scope="col" class="dashboard-column-secondary">@BackOfficeStrings.Owner</th>
            <th scope="col" class="dashboard-column-end">@BackOfficeStrings.SignedUp</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in _read.Value!)
        {
            <tr data-testid="recent-signups-row">
                <td class="dashboard-cell-primary">@row.Name</td>
                <td class="dashboard-column-secondary">@(row.Owner is { } owner ? DashboardFormat.GetPersonName(owner.FirstName, owner.LastName, owner.Email) : DashboardFormat.Missing)</td>
                <td class="dashboard-column-end dashboard-cell-muted">@RelativeTime.Format(row.CreatedAt, TimeProvider.System.GetUtcNow())</td>
            </tr>
        }
        </tbody>
    </table>
</DashboardCard>

@code {

    private readonly BackOfficeRead<BackOfficeDashboardRecentSignup[]> _read = new();

    public void Dispose()
    {
        _read.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await _read.LoadAsync(
            cancellationToken => Services.GetRequiredService<BackOfficeClient>().GetRecentSignupsAsync(DashboardFormat.RecentLimit, cancellationToken),
            response => response.Signups, Services.GetRequiredService<ApiFailurePresenter>()
        );
    }

}
