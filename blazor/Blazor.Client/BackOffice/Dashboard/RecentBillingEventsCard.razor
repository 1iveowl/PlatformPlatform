@using Account.Client
@using Blazor.Client.BackOffice.Shared
@using Account.Features.BackOffice.Dashboard.Queries
@* The recent billing events card, shown only with the subscription setting on, from GET
   /api/back-office/dashboard/recent-stripe-events with the React back office's limit of six rows, and View all to
   billing-events. *@
@implements IDisposable
@inject IServiceProvider Services

<DashboardCard TestId="recent-stripe-events" Title="@BackOfficeStrings.RecentBillingEvents" ViewAllHref='@BackOfficeUrls.ToAbsolute("billing-events")' IsLoading="_read.IsLoading" IsEmpty="_read.Value?.Length == 0"
               IsFailed="_read.IsFailed" FailureMessage="@_read.FailureMessage" OnRetry="LoadAsync"
               EmptyTitle="@BackOfficeStrings.NoRecentBillingEvents" EmptyDescription="@BackOfficeStrings.NoRecentBillingEventsDescription">
    <table class="dashboard-table">
        <caption class="visually-hidden">@BackOfficeStrings.RecentBillingEvents</caption>
        <thead>
        <tr>
            <th scope="col">@AccountStrings.Account</th>
            <th scope="col">@BackOfficeStrings.Event</th>
            <th scope="col" class="dashboard-column-secondary">@BackOfficeStrings.Plan</th>
            <th scope="col" class="dashboard-column-end">@BackOfficeStrings.MrrImpact</th>
            <th scope="col" class="dashboard-column-secondary dashboard-column-end">@BackOfficeStrings.Occurred</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in _read.Value!)
        {
            <tr data-testid="recent-stripe-events-row">
                <td class="dashboard-cell-primary">@row.TenantName</td>
                <td>
                    <span class="dashboard-badge">@DashboardFormat.GetBillingEventTypeLabel(row.Type)</span>
                </td>
                <td class="dashboard-column-secondary">@(row.ToPlan is { } plan ? DashboardFormat.GetPlanLabel(plan) : DashboardFormat.Missing)</td>
                <td class="dashboard-column-end dashboard-cell-number @(row.AmountDelta < 0 ? DashboardFormat.GetToneClass("dashboard-tone", DashboardTone.Negative) : null)">@(row.AmountDelta is { } delta ? DashboardFormat.FormatMoney(delta, row.Currency) : DashboardFormat.Missing)</td>
                <td class="dashboard-column-secondary dashboard-column-end dashboard-cell-muted"><RelativeTimeLabel Value="row.OccurredAt"/></td>
            </tr>
        }
        </tbody>
    </table>
</DashboardCard>

@code {

    private readonly BackOfficeRead<BackOfficeDashboardStripeEvent[]> _read = new();

    public void Dispose()
    {
        _read.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await _read.LoadAsync(
            cancellationToken => Services.GetRequiredService<BackOfficeClient>().GetRecentStripeEventsAsync(DashboardFormat.RecentLimit, cancellationToken),
            response => response.Events, Services.GetRequiredService<ApiFailurePresenter>()
        );
    }

}
