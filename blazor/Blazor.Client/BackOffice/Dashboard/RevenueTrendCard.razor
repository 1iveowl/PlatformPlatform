@using Account.Client
@using Blazor.Client.BackOffice.Shared
@using Account.Features.BackOffice.Dashboard.Queries
@* The revenue card, an area chart of the cumulative revenue excluding VAT a day in the selected period against the
   prior period, from GET /api/back-office/dashboard/revenue-trend. Shown only with the subscription setting on. A newer
   period's answer replaces an older one that arrives late, so the card never shows a period other than the selected
   one. A failed read shows the failed state, whose Try again reads the selected period again. *@
@implements IDisposable
@inject IServiceProvider Services

<DashboardCard TestId="revenue-trend" Title="@BackOfficeStrings.Revenue" Subtitle="@(_read.IsLoaded ? DashboardChartSeries.GetRevenueSubtitle(_read.Value.Rows, _read.Value.Currency) : null)" IsLoading="_read.IsLoading"
               IsFailed="_read.IsFailed" FailureMessage="@_read.FailureMessage" OnRetry="LoadAsync">
    <DashboardTrendChart TestId="revenue-trend-chart" Caption="@BackOfficeStrings.Revenue" Rows="_read.Value.Rows" FormatValue="FormatValue"/>
</DashboardCard>

@code {

    private readonly BackOfficeRead<(DashboardTrendRow[] Rows, string? Currency)> _read = new();
    private DashboardTrendPeriod? _loadedPeriod;

    [Parameter]
    public DashboardTrendPeriod Period { get; set; }

    public void Dispose()
    {
        _read.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive || _loadedPeriod == Period) return;

        _loadedPeriod = Period;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var period = Period;
        await _read.LoadAsync(
            cancellationToken => Services.GetRequiredService<BackOfficeClient>().GetDashboardRevenueTrendAsync(period, cancellationToken),
            response => (DashboardChartSeries.FromRevenueTrend(response), response.Currency), Services.GetRequiredService<ApiFailurePresenter>()
        );
    }

    // An amount in the platform currency, or the bare number when the API knows no currency
    private string FormatValue(decimal value)
    {
        return string.IsNullOrWhiteSpace(_read.Value.Currency) ? DashboardChartSeries.FormatValue(value) : DashboardFormat.FormatMoney(value, _read.Value.Currency);
    }

}
