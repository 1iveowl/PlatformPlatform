@using Account.Client
@using Blazor.Client.BackOffice.Shared
@using Account.Features.BackOffice.Dashboard.Queries
@using Account.Features.Subscriptions.Domain
@* The recent payments card, shown only with the subscription setting on, from GET /api/back-office/dashboard/recent-payments with the React back office's limit of six rows, and View all to invoices. *@
@implements IDisposable
@inject IServiceProvider Services

<DashboardCard TestId="recent-payments" Title="@BackOfficeStrings.RecentPayments" ViewAllHref='@BackOfficeUrls.ToAbsolute("invoices")' IsLoading="_read.IsLoading" IsEmpty="_read.Value?.Length == 0"
               IsFailed="_read.IsFailed" FailureMessage="@_read.FailureMessage" OnRetry="LoadAsync"
               EmptyTitle="@BackOfficeStrings.NoRecentPayments" EmptyDescription="@BackOfficeStrings.NoRecentPaymentsDescription">
    <table class="dashboard-table">
        <caption class="visually-hidden">@BackOfficeStrings.RecentPayments</caption>
        <thead>
        <tr>
            <th scope="col">@AccountStrings.Account</th>
            <th scope="col" class="dashboard-column-secondary">@BackOfficeStrings.Plan</th>
            <th scope="col" class="dashboard-column-end">@BackOfficeStrings.Total</th>
            <th scope="col">@BackOfficeStrings.Status</th>
            <th scope="col" class="dashboard-column-secondary dashboard-column-end">@BackOfficeStrings.Date</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var row in _read.Value!)
        {
            <tr data-testid="recent-payments-row">
                <td class="dashboard-cell-primary">@row.TenantName</td>
                <td class="dashboard-column-secondary">@(row.Plan is { } plan ? DashboardFormat.GetPlanLabel(plan) : DashboardFormat.Missing)</td>
                <td class="dashboard-column-end dashboard-cell-number @(row.Status == PaymentTransactionStatus.Refunded ? "dashboard-cell-refunded" : null)">@DashboardFormat.FormatMoney(row.Amount, row.Currency)</td>
                <td>
                    <span class="dashboard-badge @DashboardFormat.GetToneClass("dashboard-badge", DashboardFormat.GetPaymentStatusTone(row.Status))">@DashboardFormat.GetPaymentStatusLabel(row.Status)</span>
                </td>
                <td class="dashboard-column-secondary dashboard-column-end dashboard-cell-muted">@RelativeTime.Format(row.Date, TimeProvider.System.GetUtcNow())</td>
            </tr>
        }
        </tbody>
    </table>
</DashboardCard>

@code {

    private readonly BackOfficeRead<BackOfficeDashboardPayment[]> _read = new();

    public void Dispose()
    {
        _read.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await _read.LoadAsync(
            cancellationToken => Services.GetRequiredService<BackOfficeClient>().GetRecentPaymentsAsync(DashboardFormat.RecentLimit, cancellationToken),
            response => response.Payments, Services.GetRequiredService<ApiFailurePresenter>()
        );
    }

}
