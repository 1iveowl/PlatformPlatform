@using Account.Client
@using Blazor.Client.BackOffice.Shared
@* The plan distribution card, a donut of the accounts on each plan with its table, from GET /api/back-
   office/dashboard/plan-distribution. It does not follow the period. Shown only with the subscription setting on. A failed
   read shows the failed state, whose Try again reads the distribution again. *@
@implements IDisposable
@inject IServiceProvider Services

<DashboardCard TestId="plan-distribution" Title="@BackOfficeStrings.PlanDistribution" IsLoading="_read.IsLoading" IsFailed="_read.IsFailed" FailureMessage="@_read.FailureMessage" OnRetry="LoadAsync"
               Subtitle="@(_read.IsLoaded ? string.Format(CultureInfo.CurrentCulture, BackOfficeStrings.AccountsCount, DashboardFormat.FormatCount(_read.Value.Total)) : null)">
    <DashboardPlanChart TestId="plan-distribution-chart" Caption="@BackOfficeStrings.PlanDistribution" Shares="_read.Value.Shares" Total="_read.Value.Total"/>
</DashboardCard>

@code {

    private readonly BackOfficeRead<(DashboardPlanShare[] Shares, long Total)> _read = new();

    public void Dispose()
    {
        _read.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await _read.LoadAsync(
            cancellationToken => Services.GetRequiredService<BackOfficeClient>().GetDashboardPlanDistributionAsync(cancellationToken),
            response => (DashboardChartSeries.FromPlanDistribution(response), response.TotalTenants), Services.GetRequiredService<ApiFailurePresenter>()
        );
    }

}
