@using Account.Client
@using Blazor.Client.BackOffice.Shared
@using Account.Features.BackOffice.Dashboard.Queries
@* The account growth card, a bar chart of new accounts a day in the selected period against the prior period, from GET
   /api/back-office/dashboard/trends?Metric=NewTenants. A newer period's answer replaces an older one that arrives late,
   so the card never shows a period other than the selected one. A failed
   read shows the failed state, whose Try again reads the selected period again. *@
@implements IDisposable
@inject IServiceProvider Services

<DashboardCard TestId="account-growth" Title="@BackOfficeStrings.AccountGrowth" Subtitle="@(_read.IsLoaded ? DashboardChartSeries.GetAccountGrowthSubtitle(_read.Value!) : null)" IsLoading="_read.IsLoading"
               IsFailed="_read.IsFailed" FailureMessage="@_read.FailureMessage" OnRetry="LoadAsync">
    <DashboardTrendChart TestId="account-growth-chart" Caption="@BackOfficeStrings.AccountGrowth" Rows="_read.Value!" IsBarChart="true"/>
</DashboardCard>

@code {

    private readonly BackOfficeRead<DashboardTrendRow[]> _read = new();
    private DashboardTrendPeriod? _loadedPeriod;

    [Parameter]
    public DashboardTrendPeriod Period { get; set; }

    public void Dispose()
    {
        _read.Dispose();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive || _loadedPeriod == Period) return;

        _loadedPeriod = Period;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var period = Period;
        await _read.LoadAsync(
            cancellationToken => Services.GetRequiredService<BackOfficeClient>().GetDashboardTrendsAsync(DashboardTrendMetric.NewTenants, period, cancellationToken),
            DashboardChartSeries.FromTrends, Services.GetRequiredService<ApiFailurePresenter>()
        );
    }

}
