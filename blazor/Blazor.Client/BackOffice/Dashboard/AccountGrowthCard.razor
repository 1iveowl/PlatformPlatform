@using Account.Client
@using Account.Features.BackOffice.Dashboard.Queries
@* The account growth card, a bar chart of new accounts a day in the selected period against the prior period, from GET
   /api/back-office/dashboard/trends?Metric=NewTenants. A newer period's answer replaces an older one that arrives late,
   so the card never shows a period other than the selected one. *@
@inject IServiceProvider Services

<DashboardCard TestId="account-growth" Title="@BackOfficeStrings.AccountGrowth" Subtitle="@(_rows is null ? null : DashboardChartSeries.GetAccountGrowthSubtitle(_rows))" IsLoading="_rows is null">
    <DashboardTrendChart TestId="account-growth-chart" Caption="@BackOfficeStrings.AccountGrowth" Rows="_rows!" IsBarChart="true"/>
</DashboardCard>

@code {

    private DashboardTrendPeriod? _loadedPeriod;
    private DashboardTrendRow[]? _rows;
    private int _version;

    [Parameter]
    public DashboardTrendPeriod Period { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (!RendererInfo.IsInteractive || _loadedPeriod == Period) return;

        _loadedPeriod = Period;
        var version = ++_version;
        _rows = null;
        var result = await Services.GetRequiredService<BackOfficeClient>().GetDashboardTrendsAsync(DashboardTrendMetric.NewTenants, Period, CancellationToken.None);
        if (version != _version || result.Outcome == ApiCallOutcome.Unauthorized) return;

        if (!result.IsSuccess)
        {
            Services.GetRequiredService<ApiFailurePresenter>().Present(result);
            return;
        }

        _rows = DashboardChartSeries.FromTrends(result.Value);
    }

}
