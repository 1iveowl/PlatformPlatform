@* The user detail, the React back office's users/$userId page: the header, the feature flag rollouts action for an identity in
   the admins group (UserAdminActions), the activity tiles and the Accounts, Logins, Sessions, Identity and Feature flags tabs;
   the Identity tab reads the user's identity verification and offers an administrator its revoke (UserIdentityTab). After the
   pin is saved the user is read again in place, and a failed read keeps what the page shows. The tab is the URL's tab
   parameter (UserDetailTabs), and the tab links are plain links, so a reload, the back button and a copied link all land on
   the same tab. The user loads in the browser; the host prerenders the shell and the loading state. A user id the account API
   does not know, or a value that is not a user id, shows the back office's not-found state inside the shell; any other failed
   read shows the failed state, whose Try again reads the same user again. *@
@using Account.Client
@using Account.Features.Users.BackOffice.Queries
@using Blazor.Client.BackOffice.Shared
@using Blazor.Client.BackOffice.Shell
@implements IDisposable
@inject IServiceProvider Services
@inject NavigationManager Navigation

<BackOfficeShell IsSubscriptionEnabled="IsSubscriptionEnabled">
    <div class="account-detail" data-testid="back-office-user-detail" data-state="@Status.ToString().ToLowerInvariant()">
        @switch (Status)
        {
            case BackOfficeReadStatus.Loaded:
                <UserDetailHeader User="_read.Value!"/>
                <UserAdminActions User="_read.Value!" OnChanged="ReloadAsync"/>
                <UserActivityTiles User="_read.Value!"/>

                <nav class="users-tabs account-detail-tabs" aria-label="@BackOfficeStrings.UserSections" data-testid="user-tabs">
                    @foreach (var link in UserDetailTabs.Links(_read.Value!.Id, _tab))
                    {
                        <a href="@link.Href" class="users-tab" aria-current="@(link.IsCurrent ? "page" : null)" data-testid="@link.TestId">@link.Label</a>
                    }
                </nav>

                <section class="account-detail-panel" aria-label="@UserDetailTabs.Label(_tab)" data-testid="@($"user-panel-{UserDetailTabs.ToValue(_tab)}")">
                    @switch (_tab)
                    {
                        case UserDetailTab.Logins:
                            <UserLoginsTab UserId="_read.Value!.Id"/>
                            break;
                        case UserDetailTab.Sessions:
                            <UserSessionsTab UserId="_read.Value!.Id"/>
                            break;
                        case UserDetailTab.Identity:
                            <UserIdentityTab User="_read.Value!"/>
                            break;
                        case UserDetailTab.FeatureFlags:
                            <UserFeatureFlagsTab UserId="_read.Value!.Id"/>
                            break;
                        default:
                            <UserAccountsTab User="_read.Value!"/>
                            break;
                    }
                </section>
                break;
            case BackOfficeReadStatus.NotFound:
                <NotFoundContent HomeUrl="@BackOfficeUrls.Home"/>
                break;
            case BackOfficeReadStatus.Failed:
                <BackOfficeReadFailure TestId="user-detail-failed" Message="@_read.FailureMessage" OnRetry="LoadAsync"/>
                break;
            case BackOfficeReadStatus.Loading:
                <p class="account-detail-loading" role="status" data-testid="user-detail-loading">@CommonStrings.Loading</p>
                break;
        }
    </div>
</BackOfficeShell>

@code {

    private readonly BackOfficeRead<BackOfficeUserDetailResponse> _read = new(true);
    private UserDetailTab _tab;

    // The parsed route value once interactive; null while prerendering and for a value that is not a user id
    private SharedKernel.Domain.UserId? _userId;

    // The route value of the host page, as the address bar carries it
    [Parameter]
    [EditorRequired]
    public string UserId { get; set; } = "";

    // BACK_OFFICE_SUBSCRIPTION_ENABLED, passed in by the host page
    [Parameter]
    public bool IsSubscriptionEnabled { get; set; }

    private bool IsUnknownUserId => RendererInfo.IsInteractive && _userId is null;

    private BackOfficeReadStatus Status => IsUnknownUserId ? BackOfficeReadStatus.NotFound : _read.Status;

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        _read.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        _tab = UserDetailTabs.FromUri(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;
        if (!RendererInfo.IsInteractive) return;

        _userId = BackOfficeUsersListSource.ParseUserId(UserId);
        if (_userId is null) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await _read.LoadAsync(ReadAsync, user => user, Services.GetRequiredService<ApiFailurePresenter>());
    }

    private async Task ReloadAsync()
    {
        await _read.RefreshAsync(ReadAsync, user => user, Services.GetRequiredService<ApiFailurePresenter>());
    }

    // Resolved lazily: the host does not register the back-office client, so prerendering never constructs it
    private Task<ApiCallResult<BackOfficeUserDetailResponse>> ReadAsync(CancellationToken cancellationToken)
    {
        return Services.GetRequiredService<BackOfficeClient>().GetUserAsync(_userId!, cancellationToken);
    }

    // A tab link is an enhanced navigation that keeps this component alive, so the tab follows the location
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        var tab = UserDetailTabs.FromUri(args.Location);
        if (tab == _tab) return;

        _tab = tab;
        _ = InvokeAsync(StateHasChanged);
    }

}
