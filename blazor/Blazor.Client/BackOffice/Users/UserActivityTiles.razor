@using Account.Client
@using Blazor.Client.BackOffice.Shared
@using Account.Features.Users.BackOffice.Queries
@using Account.Features.Users.BackOffice.Requests
@using Blazor.Client.BackOffice.Dashboard
@* The user detail's activity tiles, the React back office's UserActivityTiles: the number of accounts the person is a member
   of, which opens the Accounts tab; the last sign-in, which opens the Logins tab once there is one; and the number of
   sessions across those accounts from GET /api/back-office/users/{id}/sessions, which opens the Sessions tab once there is
   one. A tile with nothing to open is not a link. A failed read of the sessions shows the compact failed state in the sessions
   tile, whose Try again reads the count again. *@
@implements IDisposable
@inject IServiceProvider Services

<div class="account-detail-tiles" data-testid="user-detail-tiles">
    <a class="account-detail-tile" href="@UserDetailTabs.ToUrl(User.Id, UserDetailTab.Accounts)" data-testid="user-tile-accounts">
        <span class="account-detail-tile-label">@BackOfficeStrings.Accounts</span>
        <span class="account-detail-tile-value" data-testid="user-tile-accounts-count">@DashboardFormat.FormatCount(User.TenantMemberships.Length)</span>
        <span class="account-detail-tile-subtitle">@UserDetailFormat.GetMembershipsLabel(User.TenantMemberships.Length)</span>
    </a>

    @if (User.LastSeenAt is { } lastSeenAt)
    {
        <a class="account-detail-tile" href="@UserDetailTabs.ToUrl(User.Id, UserDetailTab.Logins)" data-testid="user-tile-last-login">
            <span class="account-detail-tile-label">@BackOfficeStrings.LastLogin</span>
            <span class="account-detail-tile-value">@UserDetailFormat.FormatDateTime(lastSeenAt)</span>
            <span class="account-detail-tile-subtitle">@BackOfficeStrings.MostRecentActivity</span>
        </a>
    }
    else
    {
        <div class="account-detail-tile" data-testid="user-tile-last-login">
            <span class="account-detail-tile-label">@BackOfficeStrings.LastLogin</span>
            <span class="account-detail-tile-value">@DashboardFormat.Missing</span>
            <span class="account-detail-tile-subtitle">@BackOfficeStrings.NeverLoggedIn</span>
        </div>
    }

    @if (_read is { IsLoaded: true, Value: > 0 })
    {
        <a class="account-detail-tile" href="@UserDetailTabs.ToUrl(User.Id, UserDetailTab.Sessions)" data-testid="user-tile-sessions">
            <span class="account-detail-tile-label">@AccountStrings.Sessions</span>
            <span class="account-detail-tile-value" data-testid="user-tile-sessions-count">@DashboardFormat.FormatCount(_read.Value)</span>
            <span class="account-detail-tile-subtitle">@BackOfficeStrings.AllTime</span>
        </a>
    }
    else
    {
        <div class="account-detail-tile" data-testid="user-tile-sessions" data-state="@_read.Status.ToString().ToLowerInvariant()">
            <span class="account-detail-tile-label">@AccountStrings.Sessions</span>
            <span class="account-detail-tile-value" data-testid="user-tile-sessions-count">@(_read.IsLoaded ? DashboardFormat.FormatCount(_read.Value) : DashboardFormat.Missing)</span>
            @if (_read.IsLoaded)
            {
                <span class="account-detail-tile-subtitle">@BackOfficeStrings.AllTime</span>
            }
            else if (_read.IsFailed)
            {
                <BackOfficeReadFailure TestId="user-tile-sessions-failed" Compact OnRetry="LoadAsync"/>
            }
        </div>
    }
</div>

@code {

    // Only the total is needed, so the tile asks for the smallest page
    private static readonly GetBackOfficeUserSessionsQuery CountQuery = new(0, 1);

    private readonly BackOfficeRead<int> _read = new();

    [Parameter]
    [EditorRequired]
    public BackOfficeUserDetailResponse User { get; set; } = null!;

    public void Dispose()
    {
        _read.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await _read.LoadAsync(
            cancellationToken => Services.GetRequiredService<BackOfficeClient>().GetUserSessionsAsync(User.Id, CountQuery, cancellationToken),
            response => response.TotalCount, Services.GetRequiredService<ApiFailurePresenter>()
        );
    }

}
