@* The account detail, the React back office's accounts/$tenantId page: the header, the admin actions
   for an identity in the admins group (AccountAdminActions), the health tiles and the Overview, Users, Invoices, Billing events and Feature flags tabs, the two billing tabs only with the
   subscription setting on.
   After an admin action the account is read again in place, and a failed read keeps what the page shows. The tab is the
   URL's tab parameter (AccountDetailTabs), and the tab links are plain links, so a reload, the back button and a copied link
   all land on the same tab. The account loads in the browser; the host prerenders the shell and the loading state. A tenant id
   the account API does not know shows the back office's not-found state inside the shell; any other failed read shows the
   failed state, whose Try again reads the same account again. *@
@using Account.Client
@using Account.Features.Tenants.BackOffice.Queries
@using Blazor.Client.BackOffice.Shared
@using Blazor.Client.BackOffice.Shell
@implements IDisposable
@inject IServiceProvider Services
@inject NavigationManager Navigation

<BackOfficeShell IsSubscriptionEnabled="IsSubscriptionEnabled">
    <div class="account-detail" data-testid="back-office-account-detail" data-state="@_read.Status.ToString().ToLowerInvariant()">
        @switch (_read.Status)
        {
            case BackOfficeReadStatus.Loaded:
                <AccountDetailHeader Tenant="_read.Value!"/>
                <AccountAdminActions Tenant="_read.Value!" IsSubscriptionEnabled="IsSubscriptionEnabled" OnChanged="ReloadAsync"/>
                <AccountHealthTiles Tenant="_read.Value!" IsSubscriptionEnabled="IsSubscriptionEnabled"/>

                <nav class="users-tabs account-detail-tabs" aria-label="@BackOfficeStrings.AccountSections" data-testid="account-tabs">
                    @foreach (var link in AccountDetailTabs.Links(_read.Value!.Id, _tab, IsSubscriptionEnabled))
                    {
                        <a href="@link.Href" class="users-tab" aria-current="@(link.IsCurrent ? "page" : null)" data-testid="@link.TestId">@link.Label</a>
                    }
                </nav>

                <section class="account-detail-panel" aria-label="@AccountDetailTabs.Label(_tab)" data-testid="@($"account-panel-{AccountDetailTabs.ToValue(_tab)}")">
                    @switch (_tab)
                    {
                        case AccountDetailTab.Users:
                            <AccountUsersTab TenantId="_read.Value!.Id"/>
                            break;
                        case AccountDetailTab.Invoices:
                            <AccountInvoicesTab TenantId="_read.Value!.Id"/>
                            break;
                        case AccountDetailTab.BillingEvents:
                            <AccountBillingEventsTab TenantId="_read.Value!.Id"/>
                            break;
                        case AccountDetailTab.FeatureFlags:
                            <AccountFeatureFlagsTab TenantId="_read.Value!.Id"/>
                            break;
                        default:
                            <AccountOverviewTab Tenant="_read.Value!" IsSubscriptionEnabled="IsSubscriptionEnabled"/>
                            break;
                    }
                </section>
                break;
            case BackOfficeReadStatus.NotFound:
                <NotFoundContent HomeUrl="@BackOfficeUrls.Home"/>
                break;
            case BackOfficeReadStatus.Failed:
                <BackOfficeReadFailure TestId="account-detail-failed" Message="@_read.FailureMessage" OnRetry="LoadAsync"/>
                break;
            case BackOfficeReadStatus.Loading:
                <p class="account-detail-loading" role="status" data-testid="account-detail-loading">@CommonStrings.Loading</p>
                break;
        }
    </div>
</BackOfficeShell>

@code {

    private readonly BackOfficeRead<TenantDetailResponse> _read = new(true);
    private AccountDetailTab _tab;

    // The route value of the host page, which only matches a whole number
    [Parameter]
    [EditorRequired]
    public long TenantId { get; set; }

    // BACK_OFFICE_SUBSCRIPTION_ENABLED, passed in by the host page
    [Parameter]
    public bool IsSubscriptionEnabled { get; set; }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        _read.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        _tab = AccountDetailTabs.FromUri(Navigation.Uri, IsSubscriptionEnabled);
        Navigation.LocationChanged += OnLocationChanged;
        if (!RendererInfo.IsInteractive) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await _read.LoadAsync(ReadAsync, tenant => tenant, Services.GetRequiredService<ApiFailurePresenter>());
    }

    private async Task ReloadAsync()
    {
        await _read.RefreshAsync(ReadAsync, tenant => tenant, Services.GetRequiredService<ApiFailurePresenter>());
    }

    // Resolved lazily: the host does not register the back-office client, so prerendering never constructs it
    private Task<ApiCallResult<TenantDetailResponse>> ReadAsync(CancellationToken cancellationToken)
    {
        return Services.GetRequiredService<BackOfficeClient>().GetTenantAsync(new SharedKernel.Domain.TenantId(TenantId), cancellationToken);
    }

    // A tab link is an enhanced navigation that keeps this component alive, so the tab follows the location
    private void OnLocationChanged(object? sender, LocationChangedEventArgs args)
    {
        var tab = AccountDetailTabs.FromUri(args.Location, IsSubscriptionEnabled);
        if (tab == _tab) return;

        _tab = tab;
        _ = InvokeAsync(StateHasChanged);
    }

}
