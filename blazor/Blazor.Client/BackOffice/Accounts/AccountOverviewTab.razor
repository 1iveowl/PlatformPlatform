@using Account.Client
@using Blazor.Client.BackOffice.Shared
@using Account.Features.Tenants.BackOffice.Queries
@using Account.Features.Tenants.BackOffice.Requests
@using Blazor.Client.BackOffice.Dashboard
@* The account detail's Overview tab, the React back office's AccountOverviewTab and, with the subscription setting on,
   AccountCurrentPlanCard: the account's owners as cards (up to 100, as in the React back office) and the current plan with
   its price, dates, billing address, payment method and VAT number. The React owner cards link to the back office's user
   page; here the cards are not links, and the account's Users tab opens each user. The React card of recent invoices and
   billing events beside the plan comes with the billing tabs. A failed read of the owners shows the failed state, whose
   Try again reads them again. *@
@implements IDisposable
@inject IServiceProvider Services

<section class="account-detail-section" aria-labelledby="account-owners-heading" data-testid="account-owners">
    <h2 id="account-owners-heading" class="account-detail-section-title">@BackOfficeStrings.Owners</h2>
    @if (_read.IsFailed)
    {
        <BackOfficeReadFailure TestId="account-owners-failed" Message="@_read.FailureMessage" OnRetry="LoadAsync"/>
    }
    else if (_read.Value is not { } owners)
    {
        <p class="dashboard-card-loading" role="status">@CommonStrings.Loading</p>
    }
    else if (owners.Length == 0)
    {
        <div class="dashboard-card-empty" data-testid="account-owners-empty">
            <p class="dashboard-card-empty-title">@BackOfficeStrings.NoOwners</p>
            <p>@BackOfficeStrings.NoOwnersOnAccount</p>
        </div>
    }
    else
    {
        <ul class="account-owner-cards">
            @foreach (var owner in owners)
            {
                <li class="account-owner-card" data-testid="account-owner">
                    <span class="account-name">@DashboardFormat.GetPersonName(owner.FirstName, owner.LastName, owner.Email)</span>
                    @if (!string.IsNullOrWhiteSpace(owner.Title))
                    {
                        <span class="account-owner">@owner.Title</span>
                    }
                    <span class="account-owner">@owner.Email</span>
                    @if (!owner.EmailConfirmed)
                    {
                        <span class="account-plan">@UsersStrings.Pending</span>
                    }
                </li>
            }
        </ul>
    }
</section>

@if (IsSubscriptionEnabled)
{
    <AccountCurrentPlanCard Tenant="Tenant"/>
}

@code {

    // The React back office's page size for the owners it shows
    private const int OwnersPageSize = 100;

    private readonly BackOfficeRead<TenantUserSummary[]> _read = new();

    [Parameter]
    [EditorRequired]
    public TenantDetailResponse Tenant { get; set; } = null!;

    [Parameter]
    public bool IsSubscriptionEnabled { get; set; }

    public void Dispose()
    {
        _read.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var query = new GetTenantUsersQuery(Roles: [UserRole.Owner], PageSize: OwnersPageSize);
        await _read.LoadAsync(
            cancellationToken => Services.GetRequiredService<BackOfficeClient>().GetTenantUsersAsync(Tenant.Id, query, cancellationToken),
            response => response.Users, Services.GetRequiredService<ApiFailurePresenter>()
        );
    }

}
