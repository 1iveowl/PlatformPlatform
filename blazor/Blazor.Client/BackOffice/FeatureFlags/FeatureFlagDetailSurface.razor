@using Account.Client
@using Account.Features.FeatureFlags.Queries
@using Blazor.Client.BackOffice.Shared
@using Blazor.Client.BackOffice.Shell
@using SharedKernel.FeatureFlags
@* The back office's feature flag detail, the React back office's feature-flags/$flagKey page. The flag is read from
   GET /api/back-office/feature-flags with IncludeDeleted, as React reads it, and found by the URL's key
   (FeatureFlagDetail.Find); a key that names no flag shows the back office's not-found state inside the shell. The tenants
   list of an account flag (read-only for a plan-managed flag) and the users list of a user flag each keep their own
   prefixed URL state. After an action the flags are read again in place, so the page shows the account API's state; a
   failed read keeps what the page shows. Activation, rollout and deletion change every account's and user's effective
   state, so after each action, whatever its answer or the read's, the mounted audience list drops its cached pages and
   reads its current page again (FlagChanges); the list keeps its URL filters, sort and page. The flag loads in the
   browser; the host prerenders the shell and the loading state. A failed first read shows the failed state, whose Try
   again reads the flags again for the same key. *@
@implements IDisposable
@inject IServiceProvider Services

<BackOfficeShell IsSubscriptionEnabled="IsSubscriptionEnabled">
    <div class="account-detail" data-testid="back-office-feature-flag-detail" data-state="@_read.Status.ToString().ToLowerInvariant()">
        @switch (_read.Status)
        {
            case BackOfficeReadStatus.Loaded:
                var status = FeatureFlagsListSource.GetStatus(_read.Value!);
                <p>
                    <a href="@BackOfficeUrls.ToAbsolute("feature-flags")" class="button-secondary" data-testid="feature-flag-back">@BackOfficeStrings.BackToFeatureFlags</a>
                </p>
                <header class="account-detail-header" data-testid="feature-flag-header">
                    <h1 class="account-detail-name" data-testid="feature-flag-name">@FeatureFlagsListSource.NameOf(_read.Value!)</h1>
                    <p class="account-preview-badges">
                        <span class="@FeatureFlagsListSource.GetStatusClass(status)" data-testid="feature-flag-status" data-status="@status.ToString().ToLowerInvariant()">@FeatureFlagsListSource.GetStatusLabel(status)</span>
                    </p>
                    @if (FeatureFlagsListSource.DescriptionOf(_read.Value!) is { } description)
                    {
                        <p class="account-detail-facts" data-testid="feature-flag-description">@description</p>
                    }
                </header>
                <FeatureFlagInfoSection Flag="_read.Value!" OnChanged="ReloadAsync"/>
                @if (FeatureFlagOverrides.HasOverrideLists(_read.Value!))
                {
                    @if (_read.Value!.Scope == FeatureFlagScope.Tenant)
                    {
                        <FeatureFlagTenantOverrides Flag="_read.Value!" FlagChanges="_flagChanges"/>
                    }
                    else if (_read.Value!.Scope == FeatureFlagScope.User)
                    {
                        <FeatureFlagUserOverrides Flag="_read.Value!" FlagChanges="_flagChanges"/>
                    }
                }
                break;
            case BackOfficeReadStatus.NotFound:
                <NotFoundContent HomeUrl="@BackOfficeUrls.Home"/>
                break;
            case BackOfficeReadStatus.Failed:
                <BackOfficeReadFailure TestId="feature-flag-detail-failed" Message="@_read.FailureMessage" OnRetry="LoadAsync"/>
                break;
            case BackOfficeReadStatus.Loading:
                <p class="account-detail-loading" role="status" data-testid="feature-flag-detail-loading">@CommonStrings.Loading</p>
                break;
        }
    </div>
</BackOfficeShell>

@code {

    private readonly BackOfficeRead<FeatureFlagInfo> _read = new();

    // The number of actions on the flag itself since the page loaded; the audience lists refresh when it changes
    private int _flagChanges;

    // The route value of the host page, the flag's registry key as the address bar carries it
    [Parameter]
    [EditorRequired]
    public string FlagKey { get; set; } = "";

    // BACK_OFFICE_SUBSCRIPTION_ENABLED, passed in by the host page
    [Parameter]
    public bool IsSubscriptionEnabled { get; set; }

    public void Dispose()
    {
        _read.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await _read.LoadAsync(ReadAsync, Find, Services.GetRequiredService<ApiFailurePresenter>());
    }

    // Counted after the read, so a list that refreshes reads its rows for the flag the page now shows. A failed action or read
    // counts too: the account API may have stored the change even when the answer did not arrive.
    private async Task ReloadAsync()
    {
        var result = await _read.RefreshAsync(ReadAsync, Find, Services.GetRequiredService<ApiFailurePresenter>());
        if (result is null || result.Outcome == ApiCallOutcome.Unauthorized) return;

        _flagChanges++;
    }

    // Resolved lazily: the host does not register the back-office client, so prerendering never constructs it
    private Task<ApiCallResult<GetFeatureFlagsResponse>> ReadAsync(CancellationToken cancellationToken)
    {
        return Services.GetRequiredService<BackOfficeClient>().GetFeatureFlagsAsync(true, cancellationToken);
    }

    // A key that names no flag is the not-found state
    private FeatureFlagInfo? Find(GetFeatureFlagsResponse response)
    {
        return FeatureFlagDetail.Find(response.Flags, FlagKey);
    }

}
