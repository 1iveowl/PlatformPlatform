@using Account.Client
@using Account.Features.FeatureFlags.Queries
@using Blazor.Client.BackOffice.Accounts
@using Blazor.Client.BackOffice.Shared
@using Blazor.Client.BackOffice.Shell
@* The back office's feature flag list, the React back office's feature-flags page: every flag from GET
   /api/back-office/feature-flags grouped into account, plan, user and system flags (FeatureFlagsListSource), each group on
   its own DataList with its own parameter prefix, and the show-deleted toggle, which reads the flags again with
   IncludeDeleted. A row opens the flag's detail page, except a system flag's. Read-only for every back-office identity; the
   actions are on the detail page. The flags load in the browser; the host prerenders the shell and the heading. A failed read
   shows the failed state, whose Try again reads the flags again with the same show-deleted choice; a newer read drops an
   older one's answer. *@
@inject IServiceProvider Services
@inject NavigationManager Navigation
@implements IDisposable

<BackOfficeShell IsSubscriptionEnabled="IsSubscriptionEnabled">
    <div class="accounts" data-testid="back-office-feature-flags" data-state="@_read.Status.ToString().ToLowerInvariant()">
        <h1>@BackOfficeStrings.FeatureFlags</h1>
        <p class="accounts-subtitle">@BackOfficeStrings.FeatureFlagsSubtitle</p>

        <div class="accounts-toolbar" data-testid="feature-flags-toolbar">
            <div class="accounts-toggle-group" role="group" aria-label="@BackOfficeStrings.FeatureFlags">
                <button type="button" class="accounts-toggle" aria-pressed="@(_includeDeleted ? "true" : "false")" disabled="@_read.IsLoading" data-testid="feature-flags-show-deleted"
                        @onclick="ToggleDeletedAsync">
                    @BackOfficeStrings.ShowDeleted
                </button>
            </div>
        </div>

        @if (_read.IsFailed)
        {
            <BackOfficeReadFailure TestId="feature-flags-failed" Message="@_read.FailureMessage" OnRetry="LoadAsync"/>
        }
        else if (_read.Value is not { } loadedFlags)
        {
            <p class="dashboard-card-loading" role="status" data-testid="feature-flags-loading">@CommonStrings.Loading</p>
        }
        else if (loadedFlags.Count == 0)
        {
            <div class="accounts-empty" data-testid="feature-flags-empty">
                <p class="accounts-empty-title">@BackOfficeStrings.NoFeatureFlags</p>
            </div>
        }
        else
        {
            @foreach (var group in FeatureFlagsListSource.GetGroups(loadedFlags))
            {
                var flags = FeatureFlagsListSource.GetGroup(loadedFlags, group);
                var title = FeatureFlagsListSource.GetGroupLabel(group);
                var testId = $"feature-flags-{FeatureFlagsListSource.ToValue(group)}";
                <section class="account-detail-section" aria-labelledby="@($"{testId}-heading")" data-testid="@testId">
                    <h2 id="@($"{testId}-heading")" class="account-detail-section-title">@title</h2>
                    <p class="accounts-subtitle">@FeatureFlagsListSource.GetGroupDescription(group)</p>
                    <DataList TItem="FeatureFlagInfo" data-testid="@($"{testId}-grid")" ListId="@FeatureFlagsListSource.ListId(group, _includeDeleted)" CacheScope="@AccountsListSource.CacheScope"
                              Label="@title" Columns="Columns(group)" FetchPage="(request, _) => Task.FromResult(FeatureFlagsListSource.Page(flags, request))" KeySelector="KeyOf"
                              DefaultOrderBy="@FeatureFlagsListSource.DefaultOrderBy" ParameterPrefix="@FeatureFlagsListSource.ParameterPrefix(group)" RowLabel="FeatureFlagsListSource.NameOf"
                              OnActivated="@(FeatureFlagsListSource.HasDetail(group) ? OpenFlagAsync : null)">
                    </DataList>
                </section>
            }
        }
    </div>
</BackOfficeShell>

@code {

    private readonly BackOfficeRead<IReadOnlyList<FeatureFlagInfo>> _read = new();
    private bool _includeDeleted;

    // BACK_OFFICE_SUBSCRIPTION_ENABLED, passed in by the host page
    [Parameter]
    public bool IsSubscriptionEnabled { get; set; }

    public void Dispose()
    {
        _read.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        if (!RendererInfo.IsInteractive) return;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var includeDeleted = _includeDeleted;
        var result = await _read.LoadAsync(
            cancellationToken => Services.GetRequiredService<BackOfficeClient>().GetFeatureFlagsAsync(includeDeleted, cancellationToken),
            response => response.Flags, Services.GetRequiredService<ApiFailurePresenter>()
        );
        if (result?.IsSuccess != true) return;

        // The groups page this read in memory, so a page cached from an earlier read, before an action on a detail page, would
        // show the flags as they were
        var pageCache = Services.GetRequiredService<DataListPageCache>();
        foreach (var group in FeatureFlagsListSource.GroupOrder) pageCache.Invalidate(FeatureFlagsListSource.ListId(group, includeDeleted));
    }

    private async Task ToggleDeletedAsync()
    {
        _includeDeleted = !_includeDeleted;
        await LoadAsync();
    }

    // The name with its description, the required plan of a plan flag, the rollout of an A/B test in the account and user
    // groups, and the status
    private static IReadOnlyList<DataListColumn<FeatureFlagInfo>> Columns(FeatureFlagGroup group)
    {
        var columns = new List<DataListColumn<FeatureFlagInfo>> { new(BackOfficeStrings.Name, NameCell) };
        if (group == FeatureFlagGroup.Plan)
        {
            columns.Add(new DataListColumn<FeatureFlagInfo>(BackOfficeStrings.RequiredPlan,
                    flag => @<span class="account-plan">@AccountDetailFormat.GetRequiredPlanLabel(flag.RequiredPlan!)</span>, HideBelow: Breakpoint.Small
                )
            );
        }

        if (FeatureFlagsListSource.ShowsRollout(group))
        {
            columns.Add(new DataListColumn<FeatureFlagInfo>(BackOfficeStrings.Rollout, RolloutCell, HideBelow: Breakpoint.Small));
        }

        columns.Add(new DataListColumn<FeatureFlagInfo>(BackOfficeStrings.Status, StatusCell));
        return columns;
    }

    private static RenderFragment NameCell(FeatureFlagInfo flag)
    {
        return @<span class="account-name-cell" data-testid="feature-flag-row" data-flag-key="@flag.Key">
                   <span class="account-name">@FeatureFlagsListSource.NameOf(flag)</span>
                   @if (FeatureFlagsListSource.DescriptionOf(flag) is { } description)
                   {
                       <span class="account-owner">@description</span>
                   }
               </span>;
    }

    private static RenderFragment RolloutCell(FeatureFlagInfo flag)
    {
        return @<span class="@(FeatureFlagsListSource.IsRolloutInEffect(flag) ? null : "account-owner")" data-testid="feature-flag-rollout">@FeatureFlagsListSource.GetRolloutLabel(flag)</span>;
    }

    private static RenderFragment StatusCell(FeatureFlagInfo flag)
    {
        var status = FeatureFlagsListSource.GetStatus(flag);
        return @<span class="@FeatureFlagsListSource.GetStatusClass(status)" data-testid="feature-flag-status" data-status="@status.ToString().ToLowerInvariant()">@FeatureFlagsListSource.GetStatusLabel(status)</span>;
    }

    private static string KeyOf(FeatureFlagInfo flag)
    {
        return flag.Key;
    }

    private Task OpenFlagAsync(FeatureFlagInfo flag)
    {
        Navigation.NavigateTo(FeatureFlagsListSource.DetailUrl(flag.Key));
        return Task.CompletedTask;
    }

}
