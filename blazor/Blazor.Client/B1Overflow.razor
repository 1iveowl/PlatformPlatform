@* Spike code (Blazor edition, stage B1): proves that FluentOverflow's overflowchange custom event reaches .NET. Ten
   80px items in a 240px row must overflow, so OnOverflowRaised has to run at least once after the first layout. Sizes live
   in the host's app.css, see the note there. *@
@using Microsoft.FluentUI.AspNetCore.Components
@implements IAsyncDisposable
@inject IJSRuntime JavaScriptRuntime

<h1>B1 overflow event check</h1>

<div class="b1-overflow-row">
    <FluentOverflow OnOverflowRaised="OverflowRaised" data-testid="overflow">
        @for (var index = 1; index <= 10; index++)
        {
            <div class="b1-overflow-item">Item @index</div>
        }
    </FluentOverflow>
</div>

<p>Overflow events received by .NET: <span data-testid="overflow-raised-count">@_raisedCount</span></p>
<p>Overflowing items in the last event: <span data-testid="overflow-item-count">@_overflowingItemCount</span></p>

@code {

    private IJSObjectReference? _interactiveMarkerModule;
    private int _overflowingItemCount;
    private int _raisedCount;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive) return;

        _interactiveMarkerModule = await JavaScriptRuntime.InvokeAsync<IJSObjectReference>("import", "./js/b1-interactive.js");
        await _interactiveMarkerModule.InvokeVoidAsync("markInteractive");
    }

    private void OverflowRaised(IEnumerable<OverflowItem> items)
    {
        _raisedCount++;
        _overflowingItemCount = items.Count(item => item.Overflow);
    }

    public async ValueTask DisposeAsync()
    {
        if (_interactiveMarkerModule is not null)
        {
            await _interactiveMarkerModule.DisposeAsync();
        }
    }

}
