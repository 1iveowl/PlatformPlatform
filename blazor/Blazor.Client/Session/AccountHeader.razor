@* The authenticated header, rendered inside each interactive page component so no identity is written into a shared
   outer shell: the current tenant, the user's name with a link to the profile, the tenant switcher for a user with
   more than one tenant, and logout. Tenant and user data come from the bootstrap and the tenants client. Logout and the
   tenant switch run through SessionTransition, which serializes them, reconciles uncertain outcomes and leaves the runtime
   with one full document navigation; this component only renders its state. *@
@using Account.Client
@using SharedKernel.Domain
@implements IDisposable
@inject SessionState Session
@inject IServiceProvider Services

<header class="account-header" data-testid="account-header" data-tenants-state="@(_tenantsLoaded ? "loaded" : "loading")"
        data-transition-status="@_transition?.Status.ToString().ToLowerInvariant()">
    <nav aria-label="@AccountStrings.UserMenu">
        <a href="@AppUrls.AuthenticatedHome" data-testid="nav-app">@AccountStrings.Workspace</a> |
        <a href="@AppUrls.ToAbsolute("account/users")" data-testid="nav-users">@CommonStrings.Users</a> |
        <a href="@AppUrls.ToAbsolute("user/profile")" data-testid="nav-profile">@AccountStrings.Profile</a>
    </nav>

    @if (Session.Current?.User is { } user)
    {
        <p>
            <span data-testid="header-tenant-name">@TenantSwitcherOptions.GetDisplayName(user.TenantName)</span>
            <span data-testid="header-user-name">@GetDisplayName(user.FirstName, user.LastName, user.Email)</span>
        </p>
    }

    @if (RendererInfo.IsInteractive)
    {
        @if (TenantSwitcherOptions.IsVisible(_tenants))
        {
            <nav aria-label="@AccountStrings.SwitchAccount" data-testid="tenant-switcher">
                <span>@AccountStrings.SwitchAccount</span>
                <ul data-testid="tenants">
                    @foreach (var tenant in _tenants)
                    {
                        <li>
                            <button type="button" data-testid="switch-tenant" data-tenant-id="@tenant.TenantId" disabled="@(tenant.IsCurrent || IsTransitionBusy)"
                                    aria-current="@(tenant.IsCurrent ? "true" : null)" @onclick="() => SwitchTenantAsync(tenant.TenantId)">
                                @tenant.Name
                                @if (tenant.IsCurrent)
                                {
                                    <span class="visually-hidden"> (@AccountStrings.CurrentAccount)</span>
                                }
                            </button>
                        </li>
                    }
                </ul>
            </nav>
        }

        <button type="button" data-testid="logout" disabled="@IsTransitionBusy" aria-busy="@(_transition?.Status == SessionTransitionStatus.LoggingOut ? "true" : null)"
                @onclick="LogoutAsync">@AccountStrings.LogOut</button>

        @switch (_transition?.Status)
        {
            case SessionTransitionStatus.LogoutFailed:
                <p role="alert" data-testid="logout-failed">@AccountStrings.LogoutFailed</p>
                break;
            case SessionTransitionStatus.LogoutUnconfirmed:
                <p role="alert" data-testid="logout-unconfirmed">@AccountStrings.LogoutUnconfirmed</p>
                break;
        }
    }
</header>

@code {

    private TenantSwitcherOption[] _tenants = [];
    private bool _tenantsLoaded;
    private SessionTransition? _transition;

    private bool IsTransitionBusy => _transition?.IsBusy != false;

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        if (_transition is not null) _transition.Changed -= OnSessionChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        if (RendererInfo.IsInteractive)
        {
            _transition = Services.GetRequiredService<SessionTransition>();
            _transition.Changed += OnSessionChanged;
        }

        var bootstrap = await Session.GetAsync();
        if (!RendererInfo.IsInteractive || !bootstrap.IsAuthenticated) return;

        // A 401 is handled by the HttpClient's unauthorized handler, which leaves the runtime
        var result = await Services.GetRequiredService<TenantsClient>().GetTenantsAsync(Session.RequestsAborted);
        if (!result.IsSuccess) return;

        _tenants = TenantSwitcherOptions.Create(result.Value.Tenants, Session.Current?.User?.TenantId);
        _tenantsLoaded = true;
    }

    private static string GetDisplayName(string? firstName, string? lastName, string? email)
    {
        var name = $"{firstName} {lastName}".Trim();
        return name.Length > 0 ? name : email ?? "";
    }

    private void OnSessionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SwitchTenantAsync(TenantId tenantId)
    {
        var result = await _transition!.SwitchTenantAsync(tenantId);
        if (result is { Outcome: TenantSwitchOutcome.Failed, Failure: { } failure })
        {
            Services.GetRequiredService<ApiFailurePresenter>().Present(failure);
        }
    }

    private async Task LogoutAsync()
    {
        await _transition!.LogoutAsync();
    }

}
