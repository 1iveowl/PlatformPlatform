@* The shell every authenticated surface renders inside, the React edition's AppLayout with its side menu: the banner region
   on top, the collapsible sidebar with the main navigation, the tenant and the user menu, the mobile menu below the small
   breakpoint, and the main content with the transition alerts and the toasts. Tenants come from the tenants client after
   the bootstrap read. Logout and the tenant switch run through SessionTransition, which serializes them, reconciles
   uncertain outcomes and leaves the runtime with one full document navigation; the shell only renders its state. The
   collapsed state and Ctrl+B or Cmd+B come from shell.js; the state is a data attribute, never a style. A theme chosen in
   the user menu goes through DevicePreferences, which the preferences page shares, so both show the same mode. Once another
   tab of this browser has ended the identity this runtime showed (AuthSyncCoordinator), the main content and the tenants
   are dropped and only the non-dismissable reload dialog remains. *@
@using Account.Client
@using Blazor.Client.Bootstrap
@using Blazor.Client.Session
@implements IAsyncDisposable
@inject SessionState Session
@inject IServiceProvider Services
@inject NavigationManager Navigation
@inject IJSRuntime JavaScriptRuntime
@inject DevicePreferences Preferences

<div class="app-shell" data-testid="app-shell" data-tenants-state="@(_tenantsLoaded ? "loaded" : "loading")"
     data-transition-status="@_transition?.Status.ToString().ToLowerInvariant()" data-sidebar="@(_collapsed ? "collapsed" : "expanded")">
    <BannerRegion>
        <InstallPrompt/>
    </BannerRegion>

    <aside class="app-sidebar">
        <div class="app-sidebar-header">
            <button type="button" class="app-sidebar-toggle" aria-label="@CommonStrings.ToggleSidebar" aria-expanded="@(_collapsed ? "false" : "true")"
                    aria-controls="app-sidebar-navigation" aria-keyshortcuts="Control+B Meta+B" @onclick="ToggleSidebar">
                <span aria-hidden="true">☰</span>
            </button>
            @if (Session.Current?.User is { } user)
            {
                <span class="app-sidebar-tenant" id="shell-tenant-name">@TenantSwitcherOptions.GetDisplayName(user.TenantName)</span>
            }
        </div>

        <nav class="app-sidebar-navigation" id="app-sidebar-navigation" aria-label="@CommonStrings.MainNavigation">
            <ShellNavigationLinks Items="NavigationItems" IdPrefix="sidebar-nav"/>
        </nav>

        @* The menu stays mounted while a transition leaves the surface and the session has already cleared the identity, so
           its disabled items remain until the document is replaced *@
        <div class="app-sidebar-footer">
            @if (RendererInfo.IsInteractive)
            {
                <UserMenu User="Session.Current?.User" Items="MenuItems" DescribedBy="shell-user-name shell-tenant-name" OnSelect="OnMenuSelectAsync"/>
            }
            @if (Session.Current?.User is { } currentUser)
            {
                <span class="app-sidebar-user-name" id="shell-user-name">@ShellUser.GetDisplayName(currentUser)</span>
            }
        </div>
    </aside>

    @if (RendererInfo.IsInteractive)
    {
        <div class="app-mobile-header">
            <MobileMenu User="Session.Current?.User" Items="NavigationItems" Tenants="MenuItems.Where(item => item.Kind == UserMenuItemKind.SwitchTenant).ToArray()"
                        Themes="MobileMenuModel.ThemeItems(MenuItems)" SupportEmail="@SupportEmail" IsTransitionBusy="IsTransitionBusy" OnSelect="OnMenuSelectAsync"/>
        </div>
    }

    <main id="main-content" class="app-main" aria-label="@CommonStrings.MainContent">
        @switch (_transition?.Status)
        {
            case SessionTransitionStatus.LogoutFailed:
                <p role="alert" data-testid="logout-failed">@AccountStrings.LogoutFailed</p>
                break;
            case SessionTransitionStatus.LogoutUnconfirmed:
                <p role="alert" data-testid="logout-unconfirmed">@AccountStrings.LogoutUnconfirmed</p>
                break;
        }

        @if (_authSync?.Invalidation is { } invalidation)
        {
            <AuthSyncDialog Decision="invalidation" OnReload="_authSync.Reload"/>
        }
        else
        {
            <ToastRegion/>

            @ChildContent
        }
    </main>
</div>

@code {

    private bool _collapsed;
    private AuthSyncCoordinator? _authSync;
    private DotNetObjectReference<AppShell>? _dotNet;
    private ShellInterop? _interop;
    private OfflineShellCache? _offlineShell;
    private StaleAssetProbe? _staleAssets;
    private bool _isWide = true;
    private ShellLocationWatcher? _locationWatcher;
    private TenantSwitcherOption[] _tenants = [];
    private bool _tenantsLoaded;
    private SessionTransition? _transition;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    // The brand's support address, from the host page that renders the surface; the mobile menu offers it as a mail link
    [Parameter]
    public string? SupportEmail { get; set; }

    private bool IsTransitionBusy => _transition?.IsBusy != false;

    private IReadOnlyList<ShellNavigationItem> NavigationItems => ShellNavigation.Create(Session.Current?.User?.Role, Navigation.Uri);

    private IReadOnlyList<UserMenuItem> MenuItems => UserMenuModel.Create(Session.Current?.User?.Role, _tenants, IsTransitionBusy, Preferences.Theme);

    [JSInvokable]
    public async Task ToggleSidebar()
    {
        await InvokeAsync(async () =>
            {
                _collapsed = !_collapsed;
                StateHasChanged();
                if (_interop is not null && ShellSidebarState.ShouldPersist(_isWide)) await _interop.StoreCollapsedAsync(_collapsed);
            }
        );
    }

    [JSInvokable]
    public async Task OnViewportChanged(ShellViewport viewport)
    {
        await InvokeAsync(() =>
            {
                _isWide = viewport.IsWide;
                if (!_isWide) _collapsed = true;
                StateHasChanged();
            }
        );
    }

    public async ValueTask DisposeAsync()
    {
        Session.Changed -= OnStateChanged;
        Preferences.Changed -= OnStateChanged;
        _locationWatcher?.Dispose();
        if (_transition is not null) _transition.Changed -= OnStateChanged;
        if (_authSync is not null) _authSync.Changed -= OnAuthSyncChanged;
        if (_interop is not null) await _interop.DisposeAsync();
        if (_offlineShell is not null) await _offlineShell.DisposeAsync();
        _dotNet?.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnStateChanged;
        Preferences.Changed += OnStateChanged;

        // Enhanced navigation changes the location without re-rendering a shell that stays alive across it, so the
        // sidebar and the mobile menu would keep marking the page the user came from
        _locationWatcher = new ShellLocationWatcher(Navigation, OnNavigated);
        if (RendererInfo.IsInteractive)
        {
            _transition = Services.GetRequiredService<SessionTransition>();
            _transition.Changed += OnStateChanged;
            _authSync = Services.GetRequiredService<AuthSyncCoordinator>();
            _authSync.Changed += OnAuthSyncChanged;
        }

        var bootstrap = await Session.GetUnlessLeavingAsync();
        if (bootstrap is null || !RendererInfo.IsInteractive || !bootstrap.IsAuthenticated) return;

        await _authSync!.AttachAsync(bootstrap);

        // A 401 is handled by the HttpClient's unauthorized handler, which leaves the runtime
        var result = await Session.UnlessLeavingAsync(Services.GetRequiredService<TenantsClient>().GetTenantsAsync);
        if (result is null || !result.IsSuccess) return;

        if (_authSync.Invalidation is not null) return;

        _tenants = TenantSwitcherOptions.Create(result.Value.Tenants, Session.Current?.User?.TenantId);
        _tenantsLoaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive) return;

        _interop = new ShellInterop(JavaScriptRuntime);
        _dotNet = DotNetObjectReference.Create(this);
        var state = await _interop.AttachShellAsync(_dotNet);
        _isWide = state.IsWide;
        _collapsed = ShellSidebarState.IsCollapsed(state.StoredCollapsed, state.IsWide);
        StateHasChanged();
        await Preferences.LoadAsync();

        // The fingerprinted asset set this document was built with, watched for the deployment that replaces it: an asset of
        // this publish that is no longer served makes this runtime stale and its next write ask for a reload instead
        _staleAssets = Services.GetRequiredService<StaleAssetProbe>();
        await _staleAssets.StartAsync();

        // The offline shell the service worker stored, dropped when this runtime's session ends; the module is imported
        // here because the departure itself has no time to await an import
        _offlineShell = Services.GetRequiredService<OfflineShellCache>();
        await _offlineShell.AttachAsync();

        // The subscription this browser made for the signed-in account, forgotten when this runtime's session ends, so a
        // notification for the account that left is never shown to whoever signs in next; the module is imported here for
        // the same reason the offline shell's is
        await Services.GetRequiredService<PushNotificationDeparture>().AttachAsync();
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    // A navigation inside the application is where a tab that has been open across a deployment is used again, so it is
    // where the publish this runtime belongs to is checked for still being served
    private void OnNavigated()
    {
        OnStateChanged();
        if (_staleAssets is not null) _ = _staleAssets.CheckAsync();
    }

    private void OnAuthSyncChanged()
    {
        _tenants = [];
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnMenuSelectAsync(UserMenuItem item)
    {
        switch (item.Kind)
        {
            case UserMenuItemKind.SwitchTenant when item.Tenant is { } tenant:
                var result = await _transition!.SwitchTenantAsync(tenant.TenantId, tenant.Name);
                if (result is { Outcome: TenantSwitchOutcome.Failed, Failure: { } failure }) Services.GetRequiredService<ApiFailurePresenter>().Present(failure);
                break;
            case UserMenuItemKind.LogOut:
                await _transition!.LogoutAsync();
                break;
            case UserMenuItemKind.Theme when item.Theme is { } mode:
                await Preferences.ChangeThemeAsync(mode);
                break;
        }
    }

}
