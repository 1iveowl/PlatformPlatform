@using Account.Features.Authentication.Queries
@using Blazor.Client.Session
@* The bootstrap, render mode and culture probes of the authenticated surface, rendered by the home and the details page. They
   are what the browser harness and the specifications read to tell a prerendered document from a started runtime, to compare
   prerendered and interactive formatting, and to see whether an identity is still shown, so they stay on both pages until a
   later stage retires them. Nothing here is product content. *@
@inject SessionState Session

<nav>
    <a href="@AppUrls.ToAbsolute("app/details")" data-testid="nav-details">@AccountStrings.Details</a> |
    <a href="@AppUrls.ToAbsolute("legal/terms")" data-enhance-nav="false" data-testid="nav-terms">@CommonStrings.Terms</a>
</nav>

<p data-testid="render-mode">@string.Format(CultureInfo.InvariantCulture, AccountStrings.InteractiveState, RendererInfo.IsInteractive)</p>

@* A fixed number and date in the page culture, so prerendered and interactive formatting can be compared *@
<p data-testid="culture-format">@AccountStrings.NumberAndDateFormat: @SampleNumber.ToString("N2", CultureInfo.CurrentCulture) @SampleDate.ToString("d", CultureInfo.CurrentCulture)</p>

@if (_bootstrap is { } bootstrap)
{
    <dl class="surface-diagnostics">
        <dt>@AccountStrings.Authenticated</dt>
        <dd data-testid="bootstrap-authenticated">@bootstrap.IsAuthenticated</dd>
        <dt>@CommonStrings.Email</dt>
        <dd data-testid="bootstrap-email">@bootstrap.User?.Email</dd>
        <dt>@AccountStrings.Account</dt>
        <dd data-testid="bootstrap-tenant-id">@bootstrap.User?.TenantId</dd>
        <dt>@CommonStrings.AccountName</dt>
        <dd data-testid="bootstrap-tenant-name">@bootstrap.User?.TenantName</dd>
        <dt>@AccountStrings.Language</dt>
        <dd data-testid="bootstrap-locale">@bootstrap.Locale</dd>
        <dt>@AccountStrings.SystemFeatureFlags</dt>
        <dd data-testid="bootstrap-flags">@string.Join(", ", bootstrap.SystemFeatureFlags.Select(flag => $"{flag.Key}={flag.Value}"))</dd>
        <dt>@AccountStrings.RuntimeConfigurationKeys</dt>
        <dd data-testid="bootstrap-runtime-keys">@string.Join(", ", bootstrap.RuntimeConfiguration.Keys)</dd>
    </dl>
}

@if (RendererInfo.IsInteractive)
{
    <p>
        <button type="button" data-testid="reload-bootstrap" @onclick="ReloadBootstrapAsync">@AccountStrings.ReloadBootstrap</button>
    </p>

    <p data-testid="status">@_status</p>
}

@code {

    private const double SampleNumber = 1234567.891;
    private static readonly DateTime SampleDate = new(2026, 9, 15);

    private BootstrapResponse? _bootstrap;
    private string _status = "";

    protected override async Task OnInitializedAsync()
    {
        _bootstrap = await Session.GetUnlessLeavingAsync();
    }

    private async Task ReloadBootstrapAsync()
    {
        _bootstrap = await Session.RefreshUnlessLeavingAsync();
        if (_bootstrap is null) return;

        _status = string.Format(CultureInfo.CurrentCulture, AccountStrings.BootstrapReloaded, DateTime.UtcNow.ToString("O", CultureInfo.InvariantCulture));
    }

}
