@* Spike code (Blazor edition, stage B3): the users list on QuickGrid. QuickGrid has no selection column, no row keyboard
   model and no menu, so the select checkbox, the row open button, arrow-key movement (users-grid.js) and the action menu
   (FluentMenu) are added here. *@
@using Microsoft.AspNetCore.Components.QuickGrid
@inherits UsersGridBase
@implements IAsyncDisposable
@inject IJSRuntime JavaScriptRuntime

<div class="users-grid-scroll" data-testid="grid-scroll" @ref="_scrollRoot">
    <QuickGrid @ref="_grid" TGridItem="UserDetails" ItemsProvider="_itemsProvider" Virtualize="IsVirtual" ItemSize="56"
               Pagination="@(IsVirtual ? null : _pagination)" ItemKey="@(user => user.Id)" RowClass="RowClass" class="users-quickgrid" aria-label="Users">
        <TemplateColumn Title="" Class="select-cell">
            <input type="checkbox" data-testid="row-select" aria-label="@($"Select {context.Email}")" tabindex="-1"
                   checked="@SelectedIds.Contains(context.Id)" @onchange="@(args => OnSelectionToggled.InvokeAsync((context, args.Value is true)))"/>
        </TemplateColumn>
        <TemplateColumn Title="Name" SortBy="_sortByName" IsDefaultSortColumn="@(State.OrderBy == SortableUserProperties.Name)" InitialSortDirection="InitialDirection">
            <button type="button" class="row-open" data-row-focus data-testid="row-open" @onclick="@(() => OnOpenProfile.InvokeAsync(context))">
                <span data-user-row data-email="@context.Email" data-index="@RowIndex(context)" data-role="@context.Role"
                      data-selected="@(SelectedIds.Contains(context.Id) ? "true" : "false")">
                    @(context.DisplayName.Length > 0 ? context.DisplayName : context.Email)
                </span>
            </button>
            @if (!context.EmailConfirmed)
            {
                <Microsoft.FluentUI.AspNetCore.Components.FluentBadge Content="Pending"/>
            }
        </TemplateColumn>
        <TemplateColumn Title="Email" SortBy="_sortByEmail" IsDefaultSortColumn="@(State.OrderBy == SortableUserProperties.Email)" InitialSortDirection="InitialDirection">
            @context.Email
        </TemplateColumn>
        <TemplateColumn Title="Created" SortBy="_sortByCreated" IsDefaultSortColumn="@(State.OrderBy == SortableUserProperties.CreatedAt)" InitialSortDirection="InitialDirection">
            @context.CreatedAt.ToString("d")
        </TemplateColumn>
        <TemplateColumn Title="Last seen" SortBy="_sortByLastSeen" IsDefaultSortColumn="@(State.OrderBy == SortableUserProperties.LastSeenAt)" InitialSortDirection="InitialDirection">
            @(context.LastSeenAt?.ToString("d") ?? "")
        </TemplateColumn>
        <TemplateColumn Title="Role" SortBy="_sortByRole" IsDefaultSortColumn="@(State.OrderBy == SortableUserProperties.Role)" InitialSortDirection="InitialDirection">
            <Microsoft.FluentUI.AspNetCore.Components.FluentBadge Content="@context.Role.ToString()"/>
        </TemplateColumn>
        <TemplateColumn Title="Actions">
            <Microsoft.FluentUI.AspNetCore.Components.FluentButton Id="@($"actions-{context.Id}")" data-testid="row-actions" Title="User actions" Appearance="Microsoft.FluentUI.AspNetCore.Components.ButtonAppearance.Subtle" tabindex="-1">⋯</Microsoft.FluentUI.AspNetCore.Components.FluentButton>
            <Microsoft.FluentUI.AspNetCore.Components.FluentMenu Trigger="@($"actions-{context.Id}")">
                <Microsoft.FluentUI.AspNetCore.Components.FluentMenuList>
                <Microsoft.FluentUI.AspNetCore.Components.FluentMenuItem data-testid="action-view" OnClick="@(() => OnOpenProfile.InvokeAsync(context))">View profile</Microsoft.FluentUI.AspNetCore.Components.FluentMenuItem>
                @if (IsOwner)
                {
                    <Microsoft.FluentUI.AspNetCore.Components.FluentMenuItem data-testid="action-change-role" Disabled="@(context.Id == CurrentUserId)" OnClick="@(() => OnChangeRole.InvokeAsync(context))">Change role</Microsoft.FluentUI.AspNetCore.Components.FluentMenuItem>
                    <Microsoft.FluentUI.AspNetCore.Components.FluentMenuItem data-testid="action-delete" Disabled="@(context.Id == CurrentUserId)" OnClick="@(() => OnDelete.InvokeAsync(context))">Delete</Microsoft.FluentUI.AspNetCore.Components.FluentMenuItem>
                }
                </Microsoft.FluentUI.AspNetCore.Components.FluentMenuList>
            </Microsoft.FluentUI.AspNetCore.Components.FluentMenu>
        </TemplateColumn>
    </QuickGrid>
</div>
@if (!IsVirtual)
{
    <Paginator State="_pagination"/>
}

@code {

    private readonly GridSort<UserDetails> _sortByCreated = GridSort<UserDetails>.ByAscending(user => user.CreatedAt);
    private readonly GridSort<UserDetails> _sortByEmail = GridSort<UserDetails>.ByAscending(user => user.Email);
    private readonly GridSort<UserDetails> _sortByLastSeen = GridSort<UserDetails>.ByAscending(user => user.LastSeenAt);
    private readonly GridSort<UserDetails> _sortByName = GridSort<UserDetails>.ByAscending(user => user.FirstName);
    private readonly GridSort<UserDetails> _sortByRole = GridSort<UserDetails>.ByAscending(user => user.Role);
    private readonly PaginationState _pagination = new() { ItemsPerPage = UsersApiClient.PagedPageSize };
    private QuickGrid<UserDetails>? _grid;
    private GridItemsProvider<UserDetails> _itemsProvider = null!;
    private IJSObjectReference? _keyboard;
    private IJSObjectReference? _module;
    private ElementReference _scrollRoot;

    private SortDirection InitialDirection => State.SortOrder == SortOrder.Ascending ? SortDirection.Ascending : SortDirection.Descending;

    protected override async Task OnInitializedAsync()
    {
        _itemsProvider = async request =>
        {
            var (items, total) = await FetchAsync(request.StartIndex, request.Count, request.SortByColumn?.Title, request.SortByAscending, request.CancellationToken);
            return GridItemsProviderResult.From(items.ToArray(), total);
        };
        if (!IsVirtual && State.PageOffset > 0) await _pagination.SetCurrentPageIndexAsync(State.PageOffset);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _module = await JavaScriptRuntime.InvokeAsync<IJSObjectReference>("import", "./js/users-grid.js");
        _keyboard = await _module.InvokeAsync<IJSObjectReference>("attachRowKeyboard", _scrollRoot);
    }

    public override async Task RefreshAsync()
    {
        UsersApi.Invalidate();
        ClearIndex();
        if (_grid is not null) await _grid.RefreshDataAsync();
    }

    public override async Task ScrollToIndexAsync(int index)
    {
        if (_grid is not null && IsVirtual) await _grid.ScrollToItemAsync(index);
    }

    private string? RowClass(UserDetails user)
    {
        return SelectedIds.Contains(user.Id) ? "row-selected" : null;
    }

    public async ValueTask DisposeAsync()
    {
        if (_keyboard is not null) await _keyboard.InvokeVoidAsync("dispose");
        if (_module is not null) await _module.DisposeAsync();
    }

}
