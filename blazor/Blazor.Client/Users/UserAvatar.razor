@* A user's avatar: the image when the user has one, otherwise the initials. Decorative, because the name is always shown
   beside it or names the control it sits in. *@

<span class="user-avatar" aria-hidden="true">
    @if (!string.IsNullOrEmpty(AvatarUrl))
    {
        <img class="user-avatar-image" src="@AvatarUrl" alt=""/>
    }
    else
    {
        @Initials
    }
</span>

@code {

    [Parameter]
    public string? AvatarUrl { get; set; }

    [Parameter]
    [EditorRequired]
    public string Initials { get; set; } = "";

}
