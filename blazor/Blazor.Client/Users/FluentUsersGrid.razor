@* Spike code (Blazor edition, stage B3): the users list on FluentDataGrid. Server-side sort through the grid's header state,
   virtualization or FluentPaginator, SelectColumn for multi-select, FluentMenu row actions. *@
@using Microsoft.FluentUI.AspNetCore.Components
@inherits UsersGridBase

<div class="users-grid-scroll" data-testid="grid-scroll">
    <FluentDataGrid @ref="_grid" TGridItem="UserDetails" ItemsProvider="_itemsProvider" Virtualize="IsVirtual" ItemSize="56"
                    Pagination="@(IsVirtual ? null : _pagination)" ItemKey="@(user => user.Id)" OnRowClick="OnRowClickAsync"
                    DisplayMode="DataGridDisplayMode.Table" ShowHover="true" aria-label="Users">
        <SelectColumn TGridItem="UserDetails" SelectMode="DataGridSelectMode.Multiple" SelectFromEntireRow="false"
                      Property="@(user => SelectedIds.Contains(user.Id))" OnSelect="OnSelectAsync"/>
        <TemplateColumn Title="Name" SortBy="_sortByName" IsDefaultSortColumn="@(State.OrderBy == SortableUserProperties.Name)" InitialSortDirection="InitialDirection">
            <span data-user-row data-email="@context.Email" data-index="@RowIndex(context)" data-role="@context.Role"
                  data-selected="@(SelectedIds.Contains(context.Id) ? "true" : "false")">
                @(context.DisplayName.Length > 0 ? context.DisplayName : "")
                @if (!context.EmailConfirmed)
                {
                    <FluentBadge Content="Pending"/>
                }
            </span>
        </TemplateColumn>
        <TemplateColumn Title="Email" SortBy="_sortByEmail" IsDefaultSortColumn="@(State.OrderBy == SortableUserProperties.Email)" InitialSortDirection="InitialDirection">
            @context.Email
        </TemplateColumn>
        <TemplateColumn Title="Created" SortBy="_sortByCreated" IsDefaultSortColumn="@(State.OrderBy == SortableUserProperties.CreatedAt)" InitialSortDirection="InitialDirection">
            @context.CreatedAt.ToString("d")
        </TemplateColumn>
        <TemplateColumn Title="Last seen" SortBy="_sortByLastSeen" IsDefaultSortColumn="@(State.OrderBy == SortableUserProperties.LastSeenAt)" InitialSortDirection="InitialDirection">
            @(context.LastSeenAt?.ToString("d") ?? "")
        </TemplateColumn>
        <TemplateColumn Title="Role" SortBy="_sortByRole" IsDefaultSortColumn="@(State.OrderBy == SortableUserProperties.Role)" InitialSortDirection="InitialDirection">
            <FluentBadge Content="@context.Role.ToString()"/>
        </TemplateColumn>
        <TemplateColumn Title="Actions">
            <FluentButton Id="@($"actions-{context.Id}")" data-testid="row-actions" Title="User actions" Appearance="ButtonAppearance.Subtle" StopPropagation="true">⋯</FluentButton>
            <FluentMenu Trigger="@($"actions-{context.Id}")">
                <FluentMenuList>
                    <FluentMenuItem data-testid="action-view" OnClick="@(() => OnOpenProfile.InvokeAsync(context))">View profile</FluentMenuItem>
                    @if (IsOwner)
                    {
                        <FluentMenuItem data-testid="action-change-role" Disabled="@(context.Id == CurrentUserId)" OnClick="@(() => OnChangeRole.InvokeAsync(context))">Change role</FluentMenuItem>
                        <FluentMenuItem data-testid="action-delete" Disabled="@(context.Id == CurrentUserId)" OnClick="@(() => OnDelete.InvokeAsync(context))">Delete</FluentMenuItem>
                    }
                </FluentMenuList>
            </FluentMenu>
        </TemplateColumn>
    </FluentDataGrid>
</div>
@if (!IsVirtual)
{
    <FluentPaginator State="_pagination"/>
}

@code {

    private readonly GridSort<UserDetails> _sortByCreated = GridSort<UserDetails>.ByAscending(user => user.CreatedAt);
    private readonly GridSort<UserDetails> _sortByEmail = GridSort<UserDetails>.ByAscending(user => user.Email);
    private readonly GridSort<UserDetails> _sortByLastSeen = GridSort<UserDetails>.ByAscending(user => user.LastSeenAt);
    private readonly GridSort<UserDetails> _sortByName = GridSort<UserDetails>.ByAscending(user => user.FirstName);
    private readonly GridSort<UserDetails> _sortByRole = GridSort<UserDetails>.ByAscending(user => user.Role);
    private readonly PaginationState _pagination = new() { ItemsPerPage = UsersApiClient.PagedPageSize };
    private const long SelectionClickWindowMilliseconds = 250;
    private FluentDataGrid<UserDetails>? _grid;
    private long _lastSelectionToggle;
    private GridItemsProvider<UserDetails> _itemsProvider = null!;

    private DataGridSortDirection InitialDirection => State.SortOrder == SortOrder.Ascending ? DataGridSortDirection.Ascending : DataGridSortDirection.Descending;

    protected override async Task OnInitializedAsync()
    {
        _itemsProvider = async request =>
        {
            var (items, total) = await FetchAsync(request.StartIndex, request.Count, request.SortByColumn?.Title, request.SortByAscending, request.CancellationToken);
            return GridItemsProviderResult.From(items.ToArray(), total);
        };
        if (!IsVirtual && State.PageOffset > 0) await _pagination.SetCurrentPageIndexAsync(State.PageOffset);
    }

    public override async Task RefreshAsync()
    {
        UsersApi.Invalidate();
        ClearIndex();
        if (_grid is not null) await _grid.RefreshDataAsync(true);
    }

    public override async Task ScrollToIndexAsync(int index)
    {
        if (_grid is not null && IsVirtual) await _grid.ScrollToItemAsync(index);
    }

    // OnRowClick also fires for a click in the select column, even with SelectFromEntireRow="false"; a click that has just
    // toggled the selection is therefore not treated as opening the profile
    private Task OnRowClickAsync(FluentDataGridRow<UserDetails> row)
    {
        if (row.Item is null || Environment.TickCount64 - _lastSelectionToggle < SelectionClickWindowMilliseconds) return Task.CompletedTask;
        return OnOpenProfile.InvokeAsync(row.Item);
    }

    private Task OnSelectAsync((UserDetails Item, bool Selected) selection)
    {
        _lastSelectionToggle = Environment.TickCount64;
        return OnSelectionToggled.InvokeAsync((selection.Item, selection.Selected));
    }

}
