@* The users administration surface, the React edition's users page: the list on DataList with search, sort and paging in
   the URL, the side pane opened from a row or from ?userId=, and the role change with its permission rules. The host
   prerenders the frame; the list and the pane load their data only once the component runs in the browser.
   An owner invites users from the toolbar and deletes one user from the row menu or a multiple selection from the toolbar;
   UserRolePermissions decides which actions show. The role, status and modified-date filters show inline while the toolbar
   is at least 54 rem wide and otherwise behind the filter button, which carries the active count and opens the filter
   dialog; UsersFilterModel decides, toolbar-width.js measures. Owners and admins see the tabs to the recycle bin. *@
@inject SessionState Session
@inject IServiceProvider Services
@using Account.Client
@using Account.Features.Authentication.Queries
@using Blazor.Client.Bootstrap
@using Blazor.Client.Session
@using Microsoft.FluentUI.AspNetCore.Components
@using SharedKernel.Domain
@implements IAsyncDisposable
@inject ToastService Toasts
@inject DataListPageCache PageCache
@inject IJSRuntime JavaScriptRuntime

<AppShell>
    <h1>@CommonStrings.Users</h1>
    <p>@UsersStrings.ManageUsers</p>

    @if (RecycleBinPermissions.CanView(_bootstrap?.User))
    {
        <UsersTabs/>
    }

    <div class="users-toolbar" data-testid="users-toolbar" @ref="_toolbar">
        <div role="search">
            <FluentTextInput Id="@SearchId" data-testid="search" AriaLabel="@CommonStrings.Search" Placeholder="@CommonStrings.Search" Immediate="true" ImmediateDelay="500"
                             Value="@_filters.GetValueOrDefault(UsersListSource.SearchParameter)" ValueChanged="OnSearchChangedAsync"/>
        </div>
        @if (_filterModel.IsExpanded)
        {
            <UsersFilters Filters="_filters" IdPrefix="users-inline-filters" TestId="inline-filters" OnChange="SetFiltersAsync"/>
        }
        <button type="button" class="button-secondary users-filter-button" data-testid="filter-button" aria-haspopup="@(_filterModel.IsExpanded || _filterModel.IsWide ? null : "dialog")"
                @onclick="OnFilterButtonClickedAsync">
            @_filterModel.ButtonLabel
            @if (_filterModel.ShowsBadge(_filters))
            {
                <span class="users-filter-badge" data-testid="filter-count">@UsersFilterModel.ActiveCount(_filters).ToString(CultureInfo.CurrentCulture)</span>
            }
        </button>
        @if (_bootstrap is not null)
        {
            <UsersToolbar CurrentUser="_bootstrap.User" SelectedUsers="_selectedUsers" OnInvite="OpenInviteDialog" OnBulkDelete="OpenBulkDeleteDialog"/>
        }
    </div>

    <div class="users-layout">
        <div class="users-grid">
            @if (_bootstrap is not null)
            {
                <DataList @ref="_list" TItem="UserDetails" data-testid="users-grid" ListId="@UsersListSource.ListId" CacheScope="@UsersListSource.CacheScope(_bootstrap)"
                          Label="@CommonStrings.Users" Columns="_columns" FetchPage="FetchPageAsync" KeySelector="KeyOf" DefaultOrderBy="@UsersListSource.DefaultOrderBy"
                          SelectionMode="DataListSelectionMode.Multiple" PhoneLoadMode="DataListLoadMode.Infinite" SelectedKeyParameter="@UsersListSource.SelectedKeyParameter"
                          FilterParameters="UsersListSource.FilterParameters" NormalizeFilters="UsersListSource.NormalizeFilters" EscapeScopeId="@PaneId"
                          FocusFallbackId="@SearchId" RowLabel="RowLabel" SelectAllLabel="@UsersStrings.SelectAllUsers" RowMenu="RowMenu" OnActivated="OpenProfileAsync"
                          OnClosed="OnProfileClosedAsync" OnSelectionChanged="OnSelectionChangedAsync" OnMultipleSelected="CloseProfileAsync"
                          OnStateChanged="OnListStateChangedAsync">
                    <EmptyContent>
                        <div data-testid="empty-state">
                            <p>@UsersStrings.NoUsersFound</p>
                            @if (_filters.Count > 0)
                            {
                                <p>@UsersStrings.TryAdjustingSearch</p>
                            }
                        </div>
                    </EmptyContent>
                </DataList>
            }
        </div>

        <UserProfilePane Id="@PaneId" State="_profile" Permission="ProfilePermission" IsNotInCurrentView="IsProfileNotInCurrentView" IsDataUpdated="IsProfileDataUpdated"
                         OnClose="CloseProfileAsync" OnChangeRole="OpenRoleDialog"/>
    </div>

    <ChangeUserRoleDialog Open="_isRoleDialogOpen" OpenChanged="OnRoleDialogOpenChanged" User="_roleUser" OnSaved="OnRoleSavedAsync"/>

    <InviteUserDialog Open="_isInviteDialogOpen" OpenChanged="OnInviteDialogOpenChanged" OnInvited="OnInvitedAsync"/>

    <UsersFilterDialog Open="_filterModel.IsDialogOpen" OpenChanged="OnFilterDialogOpenChanged" Filters="_filters" OnChange="SetFiltersAsync" OnClear="ClearFiltersAsync"/>

    <DeleteUsersDialog Open="_isDeleteDialogOpen" OpenChanged="OnDeleteDialogOpenChanged" Users="_deleteUsers" OnDeleted="OnUsersDeletedAsync"/>
</AppShell>

@code {

    public const string RoleUpdatedToastTestId = "role-updated-toast";
    public const string UserInvitedToastTestId = "user-invited-toast";
    public const string UsersDeletedToastTestId = "users-deleted-toast";
    private const string SearchId = "users-search";

    private const string PaneId = "users-profile-pane";

    // The columns after the name, whose cell shows the email and the pending badge on phones instead
    private const string HideBelowSmall = "data-list-hide-below-sm";

    private readonly UsersFilterModel _filterModel = new();
    private readonly UserProfileState _profile = new();
    private BootstrapResponse? _bootstrap;
    private IReadOnlyList<DataListColumn<UserDetails>> _columns = [];
    private IReadOnlyList<UserDetails> _deleteUsers = [];
    private IReadOnlyDictionary<string, string> _filters = new Dictionary<string, string>();
    private bool _isDeleteDialogOpen;
    private bool _isInviteDialogOpen;
    private bool _isRoleDialogOpen;
    private DataList<UserDetails>? _list;
    private UserDetails? _roleUser;
    private IReadOnlyList<UserDetails> _selectedUsers = [];
    private DotNetObjectReference<UsersSurface>? _reference;
    private ElementReference _toolbar;
    private IJSObjectReference? _toolbarObserver;
    private bool _disposed;

    private IReadOnlyList<UserDetails> PageItems => _list is { Status: DataListStatus.Ready or DataListStatus.Empty } list ? list.Items : [];

    private bool IsListLoaded => _list?.Status is DataListStatus.Ready or DataListStatus.Empty;

    private bool IsProfileNotInCurrentView => IsListLoaded && _profile.IsNotInCurrentView(PageItems.ToArray());

    private bool IsProfileDataUpdated => IsListLoaded && _profile.IsDataUpdated(PageItems.ToArray());

    private RoleChangePermission ProfilePermission => _profile.User is { } user ? UserRolePermissions.ForTarget(_bootstrap?.User, user.Id) : RoleChangePermission.NotOwner;

    protected override async Task OnInitializedAsync()
    {
        _columns =
        [
            new DataListColumn<UserDetails>(UsersStrings.Name, user => @<span class="user-name-cell" data-user-row data-email="@user.Email">
                                                                           <UserAvatar AvatarUrl="@user.AvatarUrl" Initials="@user.Initials"/>
                                                                           <span>
                                                                               <span class="user-name" data-testid="user-name">@user.DisplayNameOrEmail</span>
                                                                               @if (!string.IsNullOrEmpty(user.Title))
                                                                               {
                                                                                   <span class="user-title">@user.Title</span>
                                                                               }
                                                                               <span class="user-title data-list-phone-only" data-testid="user-phone-email">@user.Email</span>
                                                                               @if (!user.EmailConfirmed)
                                                                               {
                                                                                   <span class="profile-pane-badge data-list-phone-only" data-testid="user-pending-badge">@UsersStrings.Pending</span>
                                                                               }
                                                                           </span>
                                                                       </span>, nameof(SortableUserProperties.Name)
            ),
            new DataListColumn<UserDetails>(CommonStrings.Email, user => @<text>@user.Email</text>, nameof(SortableUserProperties.Email), HideBelowSmall
            ),
            new DataListColumn<UserDetails>(UsersStrings.Created, user => @<text>@RelativeTime.Format(user.CreatedAt, TimeProvider.System.GetUtcNow())</text>,
                nameof(SortableUserProperties.CreatedAt), HideBelowSmall
            ),
            new DataListColumn<UserDetails>(UsersStrings.LastSeen, user => @<text>@RelativeTime.Format(user.LastSeenAt, TimeProvider.System.GetUtcNow())</text>,
                nameof(SortableUserProperties.LastSeenAt), HideBelowSmall
            ),
            new DataListColumn<UserDetails>(UsersStrings.Role, user => @<span data-testid="user-role">@UserRoleText.Label(user.Role)</span>, nameof(SortableUserProperties.Role), HideBelowSmall
            )
        ];

        var bootstrap = await Session.GetUnlessLeavingAsync();
        if (bootstrap is null) return;

        if (RendererInfo.IsInteractive && !bootstrap.IsAuthenticated)
        {
            Services.GetRequiredService<AuthenticationNavigator>().LeaveForLogin();
            return;
        }

        _bootstrap = bootstrap;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive) return;

        try
        {
            await using var module = await JavaScriptRuntime.InvokeAsync<IJSObjectReference>("import", "./js/toolbar-width.js");
            _reference = DotNetObjectReference.Create(this);
            var observer = await module.InvokeAsync<IJSObjectReference>("observeToolbarWidth", _toolbar, _reference, UsersFilterModel.InlineThresholdRem);
            if (_disposed) await observer.DisposeAsync();
            else _toolbarObserver = observer;
        }
        catch (JSDisconnectedException)
        {
            // The document is gone; the filters stay behind the button
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        try
        {
            if (_toolbarObserver is not null)
            {
                await _toolbarObserver.InvokeVoidAsync("dispose");
                await _toolbarObserver.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The document is gone, and the observer with it
        }

        _reference?.Dispose();
    }

    [JSInvokable]
    public Task OnToolbarWidthChanged(bool isWide)
    {
        if (_filterModel.WidthChanged(isWide, _filters)) StateHasChanged();
        return Task.CompletedTask;
    }

    private static string KeyOf(UserDetails user)
    {
        return user.Id.Value;
    }

    private static string RowLabel(UserDetails user)
    {
        return user.Email;
    }

    // Everyone can view a profile; only an owner sees the role and delete actions, disabled on their own row
    private RenderFragment<UserDetails> RowMenu => user =>
        @<DataListRowMenu Label="@UsersStrings.UserActions" Items="RowMenuItems(user)" TestId="user-actions"/>;

    private IReadOnlyList<DataListRowMenuItem> RowMenuItems(UserDetails user)
    {
        var viewProfile = new DataListRowMenuItem(UsersStrings.ViewProfile, () => ViewProfileAsync(user), TestId: "action-view-profile");
        if (!UserRolePermissions.IsOwner(_bootstrap?.User)) return [viewProfile];

        var canChangeRole = UserRolePermissions.ForTarget(_bootstrap?.User, user.Id) == RoleChangePermission.Allowed;
        var canDelete = UserRolePermissions.ForDelete(_bootstrap?.User, user.Id) == UserDeletePermission.Allowed;
        return
        [
            viewProfile,
            new DataListRowMenuItem(UsersStrings.ChangeRole, () => OpenRoleDialogAsync(user), !canChangeRole, "action-change-role"),
            new DataListRowMenuItem(UsersStrings.Delete, () => OpenDeleteDialogAsync([user]), !canDelete, "action-delete")
        ];
    }

    private Task<DataListFetchResult<UserDetails>> FetchPageAsync(DataListRequest request, CancellationToken cancellationToken)
    {
        return UsersListSource.FetchAsync(Services.GetRequiredService<UsersClient>(), request, cancellationToken);
    }

    // Loads, Back and Forward: a deep link or a history entry with ?userId= opens the pane for that user, on the page or not
    private async Task OnListStateChangedAsync(DataListState state)
    {
        _filters = state.Filters;
        _filterModel.FiltersChanged(_filters);
        if (state.SelectedKey is null)
        {
            _profile.Close();
            StateHasChanged();
            return;
        }

        StateHasChanged();
        if (_profile.UserId != state.SelectedKey) await LoadProfileAsync(state.SelectedKey, PageItems.FirstOrDefault(user => user.Id.Value == state.SelectedKey));
    }

    private Task OnSearchChangedAsync(string? search)
    {
        return _list?.SetFiltersAsync(new Dictionary<string, string?> { [UsersListSource.SearchParameter] = search }) ?? Task.CompletedTask;
    }

    private Task SetFiltersAsync(IReadOnlyDictionary<string, string?> changes)
    {
        return _list?.SetFiltersAsync(changes) ?? Task.CompletedTask;
    }

    // Expanded filters clear on a click; otherwise they show inline on a wide toolbar or in the dialog on a narrow one
    private Task OnFilterButtonClickedAsync()
    {
        return _filterModel.ButtonClicked() == UsersFilterButtonAction.ClearFilters ? SetFiltersAsync(UsersFilterModel.ClearChanges()) : Task.CompletedTask;
    }

    private void OnFilterDialogOpenChanged(bool isOpen)
    {
        _filterModel.IsDialogOpen = isOpen;
    }

    private Task ClearFiltersAsync()
    {
        _filterModel.Cleared();
        return SetFiltersAsync(UsersFilterModel.ClearChanges());
    }

    private Task OpenProfileAsync(UserDetails user)
    {
        return LoadProfileAsync(user.Id.Value, user);
    }

    private Task ViewProfileAsync(UserDetails user)
    {
        return _list?.ActivateItemAsync(user) ?? Task.CompletedTask;
    }

    // The pane shows the row at once and then the authoritative user; only the latest load is applied
    private async Task LoadProfileAsync(string userId, UserDetails? rowUser)
    {
        var version = _profile.Open(userId, rowUser);
        StateHasChanged();
        var result = await Services.GetRequiredService<UsersClient>().GetUserAsync(new UserId(userId), CancellationToken.None);
        if (_profile.Complete(version, result)) StateHasChanged();
    }

    private Task OnProfileClosedAsync()
    {
        _profile.Close();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task CloseProfileAsync()
    {
        return _list?.CloseAsync() ?? Task.CompletedTask;
    }

    private void OpenRoleDialog(UserDetails user)
    {
        _roleUser = user;
        _isRoleDialogOpen = true;
        StateHasChanged();
    }

    private Task OpenRoleDialogAsync(UserDetails user)
    {
        OpenRoleDialog(user);
        return Task.CompletedTask;
    }

    private void OnRoleDialogOpenChanged(bool isOpen)
    {
        _isRoleDialogOpen = isOpen;
        if (!isOpen) _roleUser = null;
    }

    // Every cached page of the list is dropped, including sorted and filtered variants the user has just left, and the pane
    // loads the user again, so neither shows the previous role
    private async Task OnRoleSavedAsync((UserDetails User, UserRole Role) change)
    {
        _isRoleDialogOpen = false;
        _roleUser = null;
        Toasts.Show(ToastKind.Success, string.Format(CultureInfo.CurrentCulture, UsersStrings.UserRoleUpdated, change.User.DisplayNameOrEmail), null, RoleUpdatedToastTestId);
        var reloadProfile = _profile.UserId == change.User.Id.Value ? LoadProfileAsync(change.User.Id.Value, null) : Task.CompletedTask;
        if (_list is not null) await _list.InvalidateAsync();
        await reloadProfile;
    }

    // The selection holds rows of the loaded page only; the list clears it on a page, sort or filter change
    private Task OnSelectionChangedAsync(IReadOnlySet<string> keys)
    {
        _selectedUsers = PageItems.Where(user => keys.Contains(user.Id.Value)).ToArray();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void OpenInviteDialog()
    {
        _isInviteDialogOpen = true;
    }

    private void OnInviteDialogOpenChanged(bool isOpen)
    {
        _isInviteDialogOpen = isOpen;
    }

    private async Task OnInvitedAsync()
    {
        _isInviteDialogOpen = false;
        Toasts.Show(ToastKind.Success, UsersStrings.UserInvited, null, UserInvitedToastTestId);
        if (_list is not null) await _list.InvalidateAsync();
    }

    private void OpenBulkDeleteDialog()
    {
        OpenDeleteDialog(_selectedUsers);
    }

    private void OpenDeleteDialog(IReadOnlyList<UserDetails> users)
    {
        _deleteUsers = users;
        _isDeleteDialogOpen = true;
        StateHasChanged();
    }

    private Task OpenDeleteDialogAsync(IReadOnlyList<UserDetails> users)
    {
        OpenDeleteDialog(users);
        return Task.CompletedTask;
    }

    private void OnDeleteDialogOpenChanged(bool isOpen)
    {
        _isDeleteDialogOpen = isOpen;
        if (!isOpen) _deleteUsers = [];
    }

    // The pane closes when it shows a deleted user, and every cached page of the list is dropped so no deleted row remains
    private async Task OnUsersDeletedAsync(IReadOnlyList<UserDetails> users)
    {
        _isDeleteDialogOpen = false;
        _deleteUsers = [];
        var message = users.Count == 1
            ? string.Format(CultureInfo.CurrentCulture, UsersStrings.UserDeleted, users[0].DisplayNameOrEmail)
            : string.Format(CultureInfo.CurrentCulture, UsersStrings.UsersDeleted, users.Count);
        Toasts.Show(ToastKind.Success, message, null, UsersDeletedToastTestId);
        if (users.Any(user => user.Id.Value == _profile.UserId)) await CloseProfileAsync();
        PageCache.Invalidate(DeletedUsersListSource.ListId);
        if (_list is not null) await _list.InvalidateAsync();
    }

}
