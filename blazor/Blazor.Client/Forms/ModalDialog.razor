@* A modal dialog on the native <dialog> element, shown with showModal through unsaved-changes.js for the top layer, the
   backdrop, inert content behind it and focus containment; the page behind it does not scroll while it is open. The
   component library's dialog is not used, so no style attribute is written; styling comes from classes in the host's
   external stylesheet. Escape, and a backdrop click when ClosesOnBackdrop is set, raise OnDismissRequested instead of
   closing, so the owner decides whether the dialog closes. *@
@implements IAsyncDisposable
@inject IJSRuntime JavaScriptRuntime

<dialog @ref="_element" class="modal-dialog" role="@Role" aria-modal="true" aria-label="@AriaLabel" aria-labelledby="@TitleId" aria-describedby="@DescriptionId" data-testid="@TestId" data-open="@(Open ? "true" : "false")">
    @if (Open)
    {
        <div class="modal-dialog-surface">
            @ChildContent
        </div>
    }
</dialog>

@code {

    private ModuleAttachment<ModalDialog>? _attachment;
    private ElementReference _element;
    private bool _isDisposed;
    private bool _shownOpen;

    [Parameter]
    public bool Open { get; set; }

    [Parameter]
    public string Role { get; set; } = "dialog";

    [Parameter]
    public string? TitleId { get; set; }

    // The accessible name of a dialog without a visible title; a dialog with one names itself through TitleId
    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? DescriptionId { get; set; }

    [Parameter]
    public bool ClosesOnBackdrop { get; set; }

    [Parameter]
    public string? TestId { get; set; }

    [Parameter]
    public EventCallback OnDismissRequested { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [JSInvokable]
    public Task RequestDismiss()
    {
        return _isDisposed ? Task.CompletedTask : OnDismissRequested.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;

        _isDisposed = true;
        if (_attachment is not null) await _attachment.DisposeAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _attachment = new ModuleAttachment<ModalDialog>(JavaScriptRuntime, "./js/unsaved-changes.js");
            await _attachment.AttachAsync(this, "attachModalDialog", reference => [_element, reference, ClosesOnBackdrop]);
        }

        if (_attachment?.Handle is not { } dialog || _shownOpen == Open) return;

        _shownOpen = Open;
        await dialog.InvokeVoidAsync(Open ? "show" : "close");
    }

}
