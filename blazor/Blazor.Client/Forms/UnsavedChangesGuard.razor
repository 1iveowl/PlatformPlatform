@* Warns before unsaved edits are lost on an interactive surface, the React edition's useUnsavedChangesGuard. While
   HasUnsavedChanges is true it guards:
   - navigation started from .NET, through NavigationManager.RegisterLocationChangingHandler
   - in-app links and Back/Forward inside the document, through unsaved-changes.js, because the framework's handlers do
     not see enhanced navigation
   - document unload, through a beforeunload listener, whose prompt wording belongs to the browser
   - closing a dialog, through ConfirmCloseAsync
   A blocked navigation or close opens the in-app "Unsaved changes" dialog: Stay keeps the page and the edits, Leave
   raises OnLeave so the page discards them and completes the original request once. An authentication loss releases the
   guard before its full document navigation starts. *@
@using Blazor.Client.Bootstrap
@implements IAsyncDisposable
@inject NavigationManager Navigation
@inject AuthenticationNavigator AuthenticationNavigator
@inject IJSRuntime JavaScriptRuntime

<ModalDialog Open="_isAlertOpen" Role="alertdialog" TitleId="@TitleId" DescriptionId="@DescriptionId" OnDismissRequested="Stay" TestId="unsaved-changes-dialog">
    <h2 id="@TitleId" class="modal-dialog-title">@CommonStrings.UnsavedChanges</h2>
    <p id="@DescriptionId">@CommonStrings.UnsavedChangesMessage</p>
    <div class="modal-dialog-actions">
        <button type="button" class="button-secondary" autofocus data-testid="unsaved-changes-stay" @onclick="Stay">@CommonStrings.Stay</button>
        <button type="button" class="button-destructive" data-testid="unsaved-changes-leave" @onclick="LeaveAsync">@CommonStrings.Leave</button>
    </div>
</ModalDialog>

@code {

    private readonly string _idPrefix = $"unsaved-changes-{Guid.NewGuid():N}";
    private ModuleAttachment<UnsavedChangesGuard>? _attachment;
    private bool _isAlertOpen;

    private bool _isDisposed;

    // Set while Leave runs: the page drops its edits there, and a browser half told the page is clean forgets which
    // navigation it blocked, which is the one Leave is about to let through
    private bool _isLeaving;

    // Set by Leave for a navigation: the render that follows the click must not arm the listeners again before the
    // document unloads. Cleared once the owner reports no unsaved changes.
    private bool _isReleased;
    private IDisposable? _locationChangingRegistration;
    private Func<Task>? _pendingClose;
    private string? _pendingLocation;
    private bool _sentDirtyState;

    [Parameter]
    public bool HasUnsavedChanges { get; set; }

    // Raised when the user chooses Leave, for the page to drop what it was guarding. The navigation continues either
    // way, but an enhanced navigation keeps this component alive, so a page the user returns to would otherwise still
    // hold the edits they were told were discarded
    [Parameter]
    public EventCallback OnLeave { get; set; }

    private string TitleId => $"{_idPrefix}-title";

    private string DescriptionId => $"{_idPrefix}-description";

    // The browser half's handle; null until it is attached and again once this component is torn down
    private IJSObjectReference? Guard => _attachment?.Handle;

    // Runs close at once when nothing is unsaved; otherwise asks first and runs it only on Leave
    public async Task ConfirmCloseAsync(Func<Task> close)
    {
        if (!HasUnsavedChanges || AuthenticationNavigator.IsLeaving)
        {
            await close();
            return;
        }

        _pendingClose = close;
        ShowAlert();
    }

    [JSInvokable]
    public void OnNavigationBlocked()
    {
        if (_isDisposed) return;

        ShowAlert();
    }

    public async ValueTask DisposeAsync()
    {
        if (_isDisposed) return;

        _isDisposed = true;
        AuthenticationNavigator.Leaving -= OnAuthenticationLeaving;
        Navigation.LocationChanged -= OnLocationChanged;
        _locationChangingRegistration?.Dispose();
        if (_attachment is not null) await _attachment.DisposeAsync();
    }

    protected override void OnInitialized()
    {
        AuthenticationNavigator.Leaving += OnAuthenticationLeaving;
        Navigation.LocationChanged += OnLocationChanged;
    }

    // The release covers the moment between Leave and the navigation it lets through, where the render that follows the
    // click must not arm the listeners again. That navigation has now happened, and enhanced navigation keeps this
    // component alive across it, so the release ends here and the browser half is told what the page holds now. Without
    // this the guard would stay released for the rest of the document's life, because a page whose edits are still
    // unsaved never reports itself clean.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs eventArgs)
    {
        if (_isDisposed || !_isReleased) return;

        _isReleased = false;
        _sentDirtyState = false;
        _ = InvokeAsync(SendDirtyStateAsync);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _locationChangingRegistration = Navigation.RegisterLocationChangingHandler(OnLocationChanging);
            _attachment = new ModuleAttachment<UnsavedChangesGuard>(JavaScriptRuntime, "./js/unsaved-changes.js");
            if (await _attachment.AttachAsync(this, "attachNavigationGuard", reference => [reference]) is null) return;

            _sentDirtyState = false;
        }

        await SendDirtyStateAsync();
    }

    private async Task SendDirtyStateAsync()
    {
        if (_isLeaving) return;

        if (!HasUnsavedChanges) _isReleased = false;
        if (Guard is not { } guard || _isReleased || _sentDirtyState == HasUnsavedChanges) return;

        _sentDirtyState = HasUnsavedChanges;
        await guard.InvokeVoidAsync("setDirty", HasUnsavedChanges);
    }

    private ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (!HasUnsavedChanges || _isReleased || AuthenticationNavigator.IsLeaving) return ValueTask.CompletedTask;

        context.PreventNavigation();
        _pendingLocation = context.TargetLocation;
        ShowAlert();
        return ValueTask.CompletedTask;
    }

    private void ShowAlert()
    {
        _isAlertOpen = true;
        StateHasChanged();
    }

    private async Task Stay()
    {
        _isAlertOpen = false;
        _pendingClose = null;
        _pendingLocation = null;
        if (Guard is { } guard) await guard.InvokeVoidAsync("cancel");
    }

    private async Task LeaveAsync()
    {
        _isAlertOpen = false;
        var pendingClose = _pendingClose;
        var pendingLocation = _pendingLocation;
        _pendingClose = null;
        _pendingLocation = null;

        _isLeaving = true;
        try
        {
            if (pendingClose is not null)
            {
                await DiscardAsync();
                await pendingClose();
                return;
            }

            if (pendingLocation is not null)
            {
                // The handler context does not say whether the request was a full load; a full document navigation
                // completes either kind correctly, and the released guard lets it through without another prompt
                _isReleased = true;
                await DiscardAsync();
                if (Guard is { } releasedGuard) await releasedGuard.InvokeVoidAsync("setDirty", false);
                _sentDirtyState = false;
                Navigation.NavigateTo(pendingLocation, true);
                return;
            }

            _isReleased = true;
            await DiscardAsync();
            if (Guard is { } proceedingGuard) await proceedingGuard.InvokeVoidAsync("proceed");

            // proceed leaves the browser half clean, as the branch above does through setDirty, so what .NET believes
            // it sent has to match
            _sentDirtyState = false;
        }
        finally
        {
            _isLeaving = false;
        }
    }

    // Leave means the edits are gone, so the page drops them
    private async Task DiscardAsync()
    {
        if (OnLeave.HasDelegate) await OnLeave.InvokeAsync();
    }

    // Synchronous in the browser, so the listeners are released before the navigator's full document navigation begins
    private void OnAuthenticationLeaving()
    {
        _isAlertOpen = false;
        _pendingClose = null;
        _pendingLocation = null;
        if (Guard is IJSInProcessObjectReference inProcessGuard) inProcessGuard.InvokeVoid("dispose");
    }

}
