<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <AssemblyName>Blazor.Client</AssemblyName>
        <RootNamespace>Blazor.Client</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
        <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <!-- The culture comes from the host page, not from the browser language, so the runtime loads the full ICU data instead
             of the shard chosen from the browser language, which would lack da-DK formatting data for an en-US browser -->
        <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.QuickGrid" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
        <PackageReference Include="Microsoft.Extensions.Localization" />
        <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    </ItemGroup>

    <ItemGroup>
        <!-- The account API contracts, shared with the server across the build-root boundary. The net10.0 project builds
             with this root's SDK and restores with the central package versions of application/ -->
        <ProjectReference Include="..\..\application\account\Contracts\Account.Contracts.csproj" />
        <!-- The typed account API clients, their transport results, header handlers and feature flag state -->
        <ProjectReference Include="..\..\application\account\Client\Account.Client.csproj" />
        <!-- The supported cultures and the en-US and da-DK strings, shared with the host and a future native client -->
        <ProjectReference Include="..\..\application\shared-kernel\SharedKernel.Localization\SharedKernel.Localization.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Account.Features.Users.Domain" />
        <Using Include="Account.Features.Users.Queries" />
        <Using Include="SharedKernel.Localization" />
        <Using Include="SharedKernel.Persistence" />
    </ItemGroup>

    <ItemGroup>
        <!-- Keeps a FluentUI event args element type that the trimmer removes, see the file -->
        <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
    </ItemGroup>

</Project>
