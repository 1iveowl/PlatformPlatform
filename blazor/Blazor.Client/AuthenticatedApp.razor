@using Account.Client
@using Account.Features.Authentication.Queries
@using Account.Features.Authentication.Requests
@using Blazor.Client.Bootstrap
@using SharedKernel.Domain
@* The interactive WebAssembly surface behind login. Prerendered by the host with the host's bootstrap adapter, then
   started in the browser, where the bootstrap comes from the account API. Leaving the authenticated state (logout, tenant
   switch, a lost session) is always a full document navigation, so nothing from the previous identity stays in memory. *@
@inject IBootstrapSource BootstrapSource
@inject IServiceProvider Services

<h1>@(Page == "details" ? "Account details" : "Your workspace")</h1>

<nav>
    <a href="@AppUrls.AuthenticatedHome" data-testid="nav-app">Workspace</a> |
    <a href="@AppUrls.ToAbsolute("app/details")" data-testid="nav-details">Details</a> |
    <a href="@AppUrls.ToAbsolute("legal/terms")" data-enhance-nav="false" data-testid="nav-terms">Terms</a>
</nav>

<p data-testid="render-mode">Interactive: @RendererInfo.IsInteractive</p>

@if (_bootstrap is { } bootstrap)
{
    <dl>
        <dt>Authenticated</dt>
        <dd data-testid="bootstrap-authenticated">@bootstrap.IsAuthenticated</dd>
        <dt>Email</dt>
        <dd data-testid="bootstrap-email">@bootstrap.User?.Email</dd>
        <dt>Tenant</dt>
        <dd data-testid="bootstrap-tenant-id">@bootstrap.User?.TenantId</dd>
        <dt>Tenant name</dt>
        <dd data-testid="bootstrap-tenant-name">@bootstrap.User?.TenantName</dd>
        <dt>Locale</dt>
        <dd data-testid="bootstrap-locale">@bootstrap.Locale</dd>
        <dt>System feature flags</dt>
        <dd data-testid="bootstrap-flags">@string.Join(", ", bootstrap.SystemFeatureFlags.Select(flag => $"{flag.Key}={flag.Value}"))</dd>
        <dt>Runtime configuration keys</dt>
        <dd data-testid="bootstrap-runtime-keys">@string.Join(", ", bootstrap.RuntimeConfiguration.Keys)</dd>
    </dl>
}

@if (RendererInfo.IsInteractive)
{
    <p>
        <button type="button" data-testid="reload-bootstrap" @onclick="ReloadBootstrapAsync">Reload bootstrap</button>
        <button type="button" data-testid="logout" @onclick="LogoutAsync">Log out</button>
    </p>

    @if (Page != "details")
    {
        <ul data-testid="tenants">
            @foreach (var tenant in _tenants)
            {
                <li>
                    <button type="button" data-testid="switch-tenant" data-tenant-id="@tenant.Id" disabled="@(tenant.Id == _bootstrap?.User?.TenantId)"
                            @onclick="() => SwitchTenantAsync(tenant.Id)">
                        Switch to @(tenant.Name ?? tenant.Id.ToString())
                    </button>
                </li>
            }
        </ul>
    }

    <p data-testid="status">@_status</p>
}

@code {

    private BootstrapResponse? _bootstrap;
    private string _status = "";
    private TenantOption[] _tenants = [];

    [Parameter]
    public string Page { get; set; } = "home";

    protected override async Task OnInitializedAsync()
    {
        _bootstrap = await BootstrapSource.GetAsync();
        if (!RendererInfo.IsInteractive) return;

        if (!_bootstrap.IsAuthenticated)
        {
            GetNavigator().LeaveForLogin();
            return;
        }

        if (Page != "details") await LoadTenantsAsync();
    }

    private async Task ReloadBootstrapAsync()
    {
        _bootstrap = await BootstrapSource.GetAsync();
        _status = $"Bootstrap reloaded at {DateTime.UtcNow:O}";
        if (!_bootstrap.IsAuthenticated) GetNavigator().LeaveForLogin();
    }

    private async Task LoadTenantsAsync()
    {
        // A 401 is handled by the HttpClient's unauthorized handler, which leaves the runtime
        var result = await GetService<TenantsClient>().GetTenantsAsync(CancellationToken.None);
        if (!result.IsSuccess) return;

        _tenants = result.Value.Tenants.Select(tenant => new TenantOption(tenant.TenantId, tenant.TenantName)).ToArray();
    }

    // The gateway turns the new session's tokens into cookies. The bootstrap is read again under the new identity, and the
    // authenticated home is then loaded as a new document, so no state of the previous tenant survives in memory
    private async Task SwitchTenantAsync(TenantId tenantId)
    {
        var result = await GetService<AuthenticationClient>().SwitchTenantAsync(new SwitchTenantCommand(tenantId), CancellationToken.None);
        if (!result.IsSuccess)
        {
            _status = $"Switch tenant failed with {result.Problem.StatusCode}";
            return;
        }

        _bootstrap = await BootstrapSource.GetAsync();
        if (!_bootstrap.IsAuthenticated)
        {
            GetNavigator().LeaveForLogin();
            return;
        }

        GetNavigator().LeaveForAuthenticatedHome();
    }

    private async Task LogoutAsync()
    {
        await GetService<AuthenticationClient>().LogoutAsync(CancellationToken.None);
        GetNavigator().LeaveForLoggedOut();
    }

    // Resolved lazily: the clients and the navigator are only used interactively, so prerendering never constructs them.
    // The antiforgery token is added by the client's handler chain from the latest bootstrap.
    private TService GetService<TService>() where TService : notnull
    {
        return Services.GetRequiredService<TService>();
    }

    private AuthenticationNavigator GetNavigator()
    {
        return GetService<AuthenticationNavigator>();
    }

    private sealed record TenantOption(TenantId Id, string? Name);

}
