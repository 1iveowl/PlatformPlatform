@using Blazor.Client.Bootstrap
@using Blazor.Client.Session
@* The account details page's interactive WebAssembly surface. Prerendered by the host with the host's bootstrap adapter, then
   started in the browser, where the bootstrap comes from the account API. Leaving the authenticated state (logout, tenant
   switch, a lost session) is always a full document navigation, so nothing from the previous identity stays in memory. *@
@inject SessionState Session
@inject IServiceProvider Services

<AppShell>
    <h1>@AccountStrings.AccountDetails</h1>

    <SurfaceDiagnostics/>
</AppShell>

@code {

    protected override async Task OnInitializedAsync()
    {
        var bootstrap = await Session.GetUnlessLeavingAsync();
        if (bootstrap is null || !RendererInfo.IsInteractive) return;

        // Resolved lazily: the navigator is only used interactively, so prerendering never constructs it
        if (!bootstrap.IsAuthenticated) Services.GetRequiredService<AuthenticationNavigator>().LeaveForLogin();
    }

}
