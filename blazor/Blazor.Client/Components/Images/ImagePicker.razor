@* One image on a button that opens its own menu, the React edition's UserAvatarPicker and TenantLogoPicker: the current
   image, the selected file's preview or the fallback the caller renders, with "Upload ..." and, while an image is shown,
   "Remove ...". The whole picker is a drop zone for one file. A picked or dropped file is checked against the receiving
   endpoint's limits (Rules) before it is accepted; a refused file shows its message under the picker and keeps the earlier
   selection. The file and its blob: preview are held by js/file-picker.js, which revokes the preview when it is replaced,
   reset or disposed with this component. The menu is in-house, as the shell's user menu, because the component library's
   menu writes style attributes; its keyboard model is MenuNavigation's. *@
@using Blazor.Client.Components.Menus
@implements IAsyncDisposable
@inject IJSRuntime JavaScriptRuntime

<div @ref="_dropZone" class="image-picker @ContainerClass" data-testid="@($"{TestIdPrefix}-drop-zone")">
    <button @ref="_trigger" type="button" id="@TriggerId" class="image-picker-trigger" aria-label="@TriggerLabel" aria-haspopup="menu"
            aria-expanded="@(_isOpen ? "true" : "false")" aria-controls="@(_isOpen ? MenuId : null)" disabled="@Disabled" data-testid="@($"{TestIdPrefix}-menu-trigger")" @onclick="Toggle">
        @ImageContent
    </button>
    @if (_isOpen)
    {
        <div class="menu-backdrop" @onclick="() => Close(false)"></div>
        <div id="@MenuId" role="menu" class="image-picker-menu" aria-labelledby="@TriggerId" @onkeydown="OnKeyDown">
            @for (var index = 0; index < Items.Count; index++)
            {
                var item = Items[index];
                var itemIndex = index;
                <button @key="item.TestId" @ref="_itemElements[itemIndex]" type="button" role="menuitem" class="menu-item" tabindex="-1" data-testid="@item.TestId"
                        @onclick="() => SelectAsync(item)">
                    @item.Label
                </button>
            }
        </div>
    }
    <input @ref="_input" type="file" class="visually-hidden" accept="@Rules.Accept" tabindex="-1" aria-hidden="true" disabled="@Disabled"
           data-testid="@($"{TestIdPrefix}-file-input")"/>
</div>
@if (_error is not null)
{
    <p class="validation-message" role="alert" data-testid="@($"{TestIdPrefix}-error")">@_error</p>
}

@code {

    private readonly ElementReference[] _itemElements = new ElementReference[2];
    private int _activeIndex = -1;
    private DotNetObjectReference<ImagePicker>? _dotNet;
    private ElementReference _dropZone;
    private string? _error;
    private ElementReference _input;
    private FilePickerInterop? _interop;
    private bool _isOpen;
    private bool _moveFocus;
    private ElementReference _trigger;

    // Distinguishes this picker's elements and test ids from another on the same page, for example "avatar" or "logo"
    [Parameter]
    [EditorRequired]
    public string TestIdPrefix { get; set; } = null!;

    // The limits of the endpoint the selected file will be sent to
    [Parameter]
    [EditorRequired]
    public ImageFileRules Rules { get; set; } = null!;

    // What the trigger shows: the saved image, the selection's preview or the caller's fallback
    [Parameter]
    [EditorRequired]
    public RenderFragment ImageContent { get; set; } = null!;

    // The image currently shown, which decides whether the menu offers to remove it; null means nothing is shown
    [Parameter]
    public string? ImageUrl { get; set; }

    [Parameter]
    [EditorRequired]
    public string TriggerLabel { get; set; } = "";

    [Parameter]
    [EditorRequired]
    public string UploadLabel { get; set; } = "";

    [Parameter]
    [EditorRequired]
    public string RemoveLabel { get; set; } = "";

    [Parameter]
    [EditorRequired]
    public string UploadTestId { get; set; } = null!;

    [Parameter]
    [EditorRequired]
    public string RemoveTestId { get; set; } = null!;

    // An extra class on the drop zone, for the shape the surface gives this picker
    [Parameter]
    public string? ContainerClass { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public EventCallback<ChosenFile> OnFileSelected { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    private string MenuId => $"{TestIdPrefix}-picker-menu";

    private string TriggerId => $"{TestIdPrefix}-picker-trigger";

    private IReadOnlyList<PickerMenuItem> Items =>
        ImageUrl is null
            ? [new PickerMenuItem(UploadLabel, UploadTestId, OpenFileDialogAsync)]
            : [new PickerMenuItem(UploadLabel, UploadTestId, OpenFileDialogAsync), new PickerMenuItem(RemoveLabel, RemoveTestId, RemoveAsync)];

    public async ValueTask DisposeAsync()
    {
        if (_interop is not null) await _interop.DisposeAsync();
        _dotNet?.Dispose();
    }

    // Called by file-picker.js for a picked or dropped file; true when the file becomes the selection
    [JSInvokable]
    public async Task<bool> OnFileChosen(ChosenFile file)
    {
        if (Disabled) return false;

        var error = Rules.Validate(file.Size, file.ContentType);
        await InvokeAsync(async () =>
            {
                _error = error;
                if (error is null) await OnFileSelected.InvokeAsync(file);
                StateHasChanged();
            }
        );
        return error is null;
    }

    // The selected file's content, bounded to the endpoint's limit, or null when nothing is selected
    public ValueTask<Stream?> ReadSelectedFileAsync(CancellationToken cancellationToken)
    {
        return _interop?.ReadSelectedAsync(Rules.MaximumFileSizeInBytes, cancellationToken) ?? ValueTask.FromResult<Stream?>(null);
    }

    // Forgets the selection and releases its preview, after a save or when the form returns to the saved image
    public async Task ResetAsync()
    {
        _error = null;
        if (_interop is not null) await _interop.ResetAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNet = DotNetObjectReference.Create(this);
            _interop = new FilePickerInterop(JavaScriptRuntime);
            await _interop.AttachAsync(_dropZone, _input, _dotNet);
        }

        if (!_moveFocus) return;

        _moveFocus = false;
        await (_isOpen && _activeIndex >= 0 ? _itemElements[_activeIndex] : _trigger).FocusAsync();
    }

    private void Toggle()
    {
        if (_isOpen)
        {
            Close(true);
            return;
        }

        _isOpen = true;
        _activeIndex = 0;
        _moveFocus = true;
    }

    private void Close(bool returnFocus)
    {
        _isOpen = false;
        _activeIndex = -1;
        _moveFocus = returnFocus;
    }

    private async Task SelectAsync(PickerMenuItem item)
    {
        Close(false);
        await item.OnSelect();
    }

    private async Task OpenFileDialogAsync()
    {
        if (_interop is not null) await _interop.OpenAsync();
    }

    private async Task RemoveAsync()
    {
        _error = null;
        await OnRemove.InvokeAsync();
    }

    private void OnKeyDown(KeyboardEventArgs args)
    {
        switch (args.Key)
        {
            case "Escape":
                Close(true);
                return;
            case "Tab":
                Close(false);
                return;
        }

        if (MenuNavigation.MoveForKey(args.Key, Items, _ => false, _activeIndex) is not { } index || index < 0) return;

        _activeIndex = index;
        _moveFocus = true;
    }

    private sealed record PickerMenuItem(string Label, string TestId, Func<Task> OnSelect);

}
