<?xml version="1.0" encoding="utf-8"?>
<!-- Spike (B1): FluentUI Blazor comes from its nightly feed until a release carries the fix for the .NET 11 custom event
     validation errors (upstream commit c813a4a6b). Every other package comes from nuget.org. Remove the feed and the
     mapping when Directory.Packages.props moves back to a nuget.org build. -->
<configuration>
    <packageSources>
        <clear/>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3"/>
        <add key="fluentui-blazor-nightly" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet9/nuget/v3/index.json"/>
    </packageSources>
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*"/>
        </packageSource>
        <packageSource key="fluentui-blazor-nightly">
            <package pattern="Microsoft.FluentUI.AspNetCore.Components"/>
        </packageSource>
    </packageSourceMapping>
</configuration>
