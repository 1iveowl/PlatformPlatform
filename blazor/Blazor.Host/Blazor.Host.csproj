<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <AssemblyName>Blazor.Host</AssemblyName>
        <RootNamespace>Blazor.Host</RootNamespace>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <!-- Brotli stays publish-only (the SDK default). With brotli at build, the Development static asset handler
             re-compresses package assets whose manifest timestamp differs from the extracted file as gzip but keeps the
             br Content-Encoding, so browsers fail with a decoding error (observed on 11.0.0-rc.1.26425.128). The RC2 hop (T017)
             owns the re-check: repeat the Development load with build-time Brotli on the new SDK and keep this setting
             unless the handler serves matching bytes -->
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Blazor.Client\Blazor.Client.csproj" />
        <ProjectReference Include="..\..\application\shared-kernel\SharedKernel.Security\SharedKernel.Security.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Markdig" />
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
    </ItemGroup>

    <!-- The component library ships its whole browser bundle as its JavaScript initializer (445 KB on disk, about 105 KB
         compressed), and blazor.web.js imports every web initializer on every document, so each static public page paid for
         it although no page outside the authenticated WebAssembly surface uses a library component. Removing it from this
         project's JS module manifest hands the import to wwwroot/js/Blazor.Host.lib.module.js, this project's own initializer,
         which loads the bundle only on a document marked data-interactive-surface and on a WebAssembly runtime start. Every
         other initializer stays, the hot reload one of Development included. Do not instead rely on the WebAssembly boot
         configuration, which lists the library under resources.libraryInitializers after a publish but leaves that list
         empty in a Development build. The two targets are separate because MSBuild runs a target once per build while a
         publish configures both manifests, and the item names are the SDK's own:
         HostSecurityTests.StaticPublicPage_WhenRendered_ShouldNameNoComponentLibraryWebInitializer fails if a future SDK
         renames them. -->
    <Target Name="RemoveComponentLibraryFromBuildJsModuleManifest" AfterTargets="ResolveJSModuleManifestBuildConfiguration">
        <ItemGroup>
            <_ExistingBuildJSModules Remove="@(_ExistingBuildJSModules)"
                                     Condition="'%(_ExistingBuildJSModules.SourceId)' == 'Microsoft.FluentUI.AspNetCore.Components'" />
        </ItemGroup>
    </Target>

    <Target Name="RemoveComponentLibraryFromPublishJsModuleManifest" AfterTargets="ResolveJSModuleManifestPublishConfiguration">
        <ItemGroup>
            <_ExistingPublishJSModules Remove="@(_ExistingPublishJSModules)"
                                       Condition="'%(_ExistingPublishJSModules.SourceId)' == 'Microsoft.FluentUI.AspNetCore.Components'" />
        </ItemGroup>
    </Target>

    <ItemGroup>
        <!-- The same brand source file the React shell reads through SharedKernel's Settings.Current -->
        <EmbeddedResource Include="..\..\application\platform-settings.jsonc" LogicalName="platform-settings.jsonc" />
        <!-- The three published legal documents the React edition ships, linked rather than copied so both editions render the
             same text. The two internal documents in that folder are deliberately left out: only these three are embedded,
             and LegalDocuments serves nothing else. WithCulture="false" keeps them in this assembly: the file names carry a
             culture, which would otherwise send each document to an en-US satellite assembly -->
        <EmbeddedResource Include="..\..\application\account\WebApp\routes\legal\terms.en-US.md" LogicalName="legal/terms.en-US.md" WithCulture="false" />
        <EmbeddedResource Include="..\..\application\account\WebApp\routes\legal\privacy.en-US.md" LogicalName="legal/privacy.en-US.md" WithCulture="false" />
        <EmbeddedResource Include="..\..\application\account\WebApp\routes\legal\dpa.en-US.md" LogicalName="legal/dpa.en-US.md" WithCulture="false" />
    </ItemGroup>

</Project>
