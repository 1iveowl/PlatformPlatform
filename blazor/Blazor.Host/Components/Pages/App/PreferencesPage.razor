@* The user's preferences page. The page is server-rendered and prerenders the WebAssembly component it hosts, which reads
   the device's theme and zoom level once it runs in the browser. *@
@page "/user/preferences"
@using Blazor.Client.Preferences
@using Blazor.Host.Shell
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@attribute [InteractiveSurface]
@inject HostShell Shell

<PageTitle>@AccountStrings.UserPreferences</PageTitle>

<PreferencesSurface SupportEmail="@Shell.Brand.SupportEmail" @rendermode="InteractiveWebAssembly"/>
