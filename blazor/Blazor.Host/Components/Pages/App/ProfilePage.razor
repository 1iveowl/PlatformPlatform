@* The user's profile page. The page is server-rendered and prerenders the WebAssembly component it hosts, which loads the
   profile only once it runs in the browser. *@
@page "/user/profile"
@using Blazor.Client.Profile
@using Blazor.Host.Shell
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@attribute [InteractiveSurface]
@inject HostShell Shell

<PageTitle>@AccountStrings.Profile</PageTitle>

<ProfileSurface SupportEmail="@Shell.Brand.SupportEmail" @rendermode="InteractiveWebAssembly"/>
