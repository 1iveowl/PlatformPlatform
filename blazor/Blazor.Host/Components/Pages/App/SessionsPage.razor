@* The user's sessions page. The page is server-rendered and prerenders the WebAssembly component it hosts, which reads the
   sessions once it runs in the browser. *@
@page "/user/sessions"
@using Blazor.Client.Sessions
@using Blazor.Host.Shell
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@attribute [InteractiveSurface]
@inject HostShell Shell

<PageTitle>@AccountStrings.UserSessions</PageTitle>

<SessionsSurface SupportEmail="@Shell.Brand.SupportEmail" @rendermode="InteractiveWebAssembly"/>
