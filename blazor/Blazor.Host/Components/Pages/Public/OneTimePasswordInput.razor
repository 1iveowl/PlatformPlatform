@using System.Linq.Expressions
@* The verification code field of a static verification page. The baseline is one visible, labelled text input that posts
   the form's OneTimePassword field, so the page works with scripts blocked. js/one-time-password.js, loaded by the host
   page, enhances that same input into six slots: it adds the enhanced class, reveals the slot boxes it draws the value
   in, upper-cases the value and submits the form once when six characters are entered. The slots are presentation only
   (aria-hidden); the input keeps the label, autofill, paste, keyboard and the error association. *@

<div class="one-time-password" data-one-time-password data-verification-state="@Outcome.StateName">
    <label for="@InputId" class="one-time-password-label">@Label</label>
    <div class="one-time-password-field">
        <InputText id="@InputId" class="one-time-password-input" Value="@Value" ValueChanged="ValueChanged" ValueExpression="ValueExpression"
                   maxlength="@CodeLength" autocomplete="one-time-code" autocapitalize="characters" spellcheck="false" autofocus="@(!Outcome.IsLocked)"
                   disabled="@Outcome.IsLocked" aria-describedby="@DescribedBy" data-testid="code"
                   data-one-time-password-input/>
        <div class="one-time-password-slots" aria-hidden="true" hidden data-one-time-password-slots>
            @for (var index = 0; index < CodeLength; index++)
            {
                <span class="one-time-password-slot" data-one-time-password-slot></span>
            }
        </div>
    </div>
</div>

@code {

    private const int CodeLength = 6;

    [Parameter]
    [EditorRequired]
    public string InputId { get; set; } = "";

    [Parameter]
    [EditorRequired]
    public string Label { get; set; } = "";

    // Bound with @bind-Value, which also supplies ValueExpression: the parent's expression names the posted field
    // (Input.OneTimePassword) and the field its validation messages belong to
    [Parameter]
    public string? Value { get; set; }

    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    [Parameter]
    public Expression<Func<string?>>? ValueExpression { get; set; }

    [Parameter]
    [EditorRequired]
    public VerificationOutcome Outcome { get; set; } = VerificationOutcome.None;

    // The ids of the validation message and the form error alert, so a screen reader reads the error with the field. The
    // input sets aria-invalid itself only for a validation message: InputBase removes a caller's aria-invalid while the
    // field has none, so an API refusal is associated through this description and the alert role instead
    [Parameter]
    public string? DescribedBy { get; set; }

}
