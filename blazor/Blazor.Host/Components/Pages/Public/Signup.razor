@* Email signup start, static server-side rendering, enhanced for the same reason as the login start *@
@page "/signup"
@using global::Account.Client
@using global::Account.Features.EmailAuthentication.Requests
@inject EmailAuthenticationClient EmailAuthentication
@inject NavigationManager Navigation

<PageTitle>Sign up</PageTitle>

<PublicNav/>

<h1>Sign up</h1>

<EditForm Model="Input" FormName="signup-start" OnValidSubmit="StartAsync" Enhance>
    <DataAnnotationsValidator/>
    <label>
        Email
        <InputText @bind-Value="Input.Email" type="email" autocomplete="email" data-testid="email"/>
    </label>
    <ValidationMessage For="() => Input.Email"/>
    <button type="submit" data-testid="submit">Create account</button>
</EditForm>

<p data-testid="form-error">@_error</p>

@code {

    private string? _error;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm(FormName = "signup-start")]
    // Null when the request is not this form's post; the getter then supplies an empty model
    private EmailForm Input
    {
        get => field ??= new EmailForm();
        set;
    }

    private async Task StartAsync()
    {
        var result = await EmailAuthentication.StartSignupAsync(new StartEmailSignupCommand(Input.Email), HttpContext.RequestAborted);
        if (!result.IsSuccess)
        {
            _error = result.Problem.GetFormErrorMessage();
            return;
        }

        Navigation.NavigateTo($"{AppUrls.ToAbsolute("signup/verify")}?id={Uri.EscapeDataString(result.Value.EmailLoginId.Value)}&email={Uri.EscapeDataString(Input.Email)}");
    }

}
