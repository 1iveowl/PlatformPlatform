@* Email signup start, static server-side rendering, enhanced for the same reason as the login start *@
@page "/signup"
@using global::Account.Client
@using global::Account.Features.EmailAuthentication.Requests
@layout StaticPageLayout
@implements IDisposable
@inject EmailAuthenticationClient EmailAuthentication
@inject NavigationManager Navigation

<PageTitle>@CommonStrings.SignUp</PageTitle>

<PublicNav/>

<h1>@AuthenticationStrings.CreateYourAccount</h1>

<EditForm EditContext="_editContext" FormName="signup-start" OnValidSubmit="StartAsync" Enhance>
    <DataAnnotationsValidator/>
    <label>
        @CommonStrings.Email
        <InputText @bind-Value="Input.Email" type="email" autocomplete="email" data-testid="email" @attributes='_fieldAria.For(() => Input.Email, "email")'/>
    </label>
    <FieldValidation FieldName="email" For="() => Input.Email"/>
    <button type="submit" data-testid="submit">@AuthenticationStrings.SignUpWithEmail</button>
</EditForm>

<ExternalLoginOptions Flow="ExternalLoginFlow.Signup"/>

<FormErrorAlert Errors="_formErrors" Id="signup-error"/>

@code {

    private EditContext _editContext = null!;
    private FieldAria _fieldAria = null!;
    private FormErrorMapper _formErrors = null!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm(FormName = "signup-start")]
    // Null when the request is not this form's post; the getter then supplies an empty model
    private EmailForm Input
    {
        get => field ??= new EmailForm();
        set;
    }

    protected override void OnInitialized()
    {
        _editContext = new EditContext(Input);
        _formErrors = new FormErrorMapper(_editContext);
        _fieldAria = new FieldAria(_editContext, "signup-error");
    }

    public void Dispose()
    {
        _formErrors.Dispose();
    }

    private async Task StartAsync()
    {
        var result = await EmailAuthentication.StartSignupAsync(new StartEmailSignupCommand(Input.Email), HttpContext.RequestAborted);
        if (!result.IsSuccess)
        {
            _formErrors.ApplyFailure(result);
            return;
        }

        var flow = VerificationFlow.Start(DateTimeOffset.UtcNow, result.Value.ValidForSeconds);
        Navigation.NavigateTo(flow.GetVerifyUrl("signup/verify", result.Value.EmailLoginId, Input.Email, null, false));
    }

}
