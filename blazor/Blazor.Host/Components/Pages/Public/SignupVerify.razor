@* One-time password verification for signup, static server-side rendering, not enhanced for the same reason as the
   login verification *@
@page "/signup/verify"
@using Blazor.Host.Shell
@using global::Account.Client
@using global::Account.Features.EmailAuthentication.Domain
@using global::Account.Features.EmailAuthentication.Requests
@implements IDisposable
@inject EmailAuthenticationClient EmailAuthentication
@inject NavigationManager Navigation

<PageTitle>Check your email</PageTitle>

<PublicNav/>

<h1>Check your email</h1>

<p data-testid="verify-email">Enter the code sent to @Email</p>

<EditForm EditContext="_editContext" FormName="signup-verify" OnValidSubmit="CompleteAsync">
    <DataAnnotationsValidator/>
    <label>
        Code
        <InputText @bind-Value="Input.OneTimePassword" autocomplete="one-time-code" data-testid="code"/>
    </label>
    <ValidationMessage For="() => Input.OneTimePassword"/>
    <button type="submit" data-testid="submit">Verify</button>
</EditForm>

<FormErrorAlert Errors="_formErrors"/>

@code {

    private EditContext _editContext = null!;
    private FormErrorMapper _formErrors = null!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm(FormName = "signup-verify")]
    // Null when the request is not this form's post; the getter then supplies an empty model
    private OneTimePasswordForm Input
    {
        get => field ??= new OneTimePasswordForm();
        set;
    }

    [SupplyParameterFromQuery]
    public string? Id { get; set; }

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    protected override void OnInitialized()
    {
        _editContext = new EditContext(Input);
        _formErrors = new FormErrorMapper(_editContext);
    }

    public void Dispose()
    {
        _formErrors.Dispose();
    }

    private async Task CompleteAsync()
    {
        // A missing id and one that is not an email login id are both a signup that cannot be completed
        if (!EmailLoginId.TryParse(Id, out var emailLoginId))
        {
            _formErrors.AddFormMessage("The signup has expired. Start again.");
            return;
        }

        var command = new CompleteEmailSignupCommand(Input.OneTimePassword, HostShell.GetLocale(HttpContext));
        var result = await EmailAuthentication.CompleteSignupAsync(emailLoginId, command, HttpContext.RequestAborted);
        if (!result.IsSuccess)
        {
            _formErrors.ApplyFailure(result);
            return;
        }

        Navigation.NavigateTo(AppUrls.AuthenticatedHome, true);
    }

}
