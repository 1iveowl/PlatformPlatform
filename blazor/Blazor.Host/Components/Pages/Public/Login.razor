@* Email login start, static server-side rendering. The form is enhanced because it stays inside the public surface: the
   account API returns an email login id and the handler redirects to the verification page. *@
@page "/login"
@using global::Account.Client
@using global::Account.Features.EmailAuthentication.Requests
@implements IDisposable
@inject EmailAuthenticationClient EmailAuthentication
@inject NavigationManager Navigation

<PageTitle>@CommonStrings.LogIn</PageTitle>

<PublicNav/>

<h1>@AuthenticationStrings.HiWelcomeBack</h1>

<p>@AuthenticationStrings.EnterEmailToLogIn</p>

@if (LoggedOut is not null)
{
    <p data-testid="logged-out">@AuthenticationStrings.LoggedOut</p>
}

<EditForm EditContext="_editContext" FormName="login-start" OnValidSubmit="StartAsync" Enhance>
    <DataAnnotationsValidator/>
    <label>
        @CommonStrings.Email
        <InputText @bind-Value="Input.Email" type="email" autocomplete="email" data-testid="email"/>
    </label>
    <ValidationMessage For="() => Input.Email"/>
    <button type="submit" data-testid="submit">@AuthenticationStrings.LogInWithEmail</button>
</EditForm>

<ExternalLoginOptions Flow="ExternalLoginFlow.Login" ReturnPath="@ReturnPath"/>

<FormErrorAlert Errors="_formErrors"/>

@code {

    private EditContext _editContext = null!;
    private FormErrorMapper _formErrors = null!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm(FormName = "login-start")]
    // Null when the request is not this form's post; the getter then supplies an empty model
    private EmailForm Input
    {
        get => field ??= new EmailForm();
        set;
    }

    [SupplyParameterFromQuery]
    public string? ReturnPath { get; set; }

    [SupplyParameterFromQuery]
    public string? LoggedOut { get; set; }

    protected override void OnInitialized()
    {
        _editContext = new EditContext(Input);
        _formErrors = new FormErrorMapper(_editContext);
    }

    public void Dispose()
    {
        _formErrors.Dispose();
    }

    private async Task StartAsync()
    {
        var result = await EmailAuthentication.StartLoginAsync(new StartEmailLoginCommand(Input.Email), HttpContext.RequestAborted);
        if (!result.IsSuccess)
        {
            _formErrors.ApplyFailure(result);
            return;
        }

        var flow = VerificationFlow.Start(DateTimeOffset.UtcNow, result.Value.ValidForSeconds);
        Navigation.NavigateTo(flow.GetVerifyUrl("login/verify", result.Value.EmailLoginId, Input.Email, ReturnPath ?? "", false));
    }

}
