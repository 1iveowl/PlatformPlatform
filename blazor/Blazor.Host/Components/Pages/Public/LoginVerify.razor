@* One-time password verification for login, static server-side rendering. The form is deliberately not
   enhanced: a successful submission crosses the authentication boundary, so the browser follows the redirect with a full
   document load and the session cookies set on that redirect by the gateway. *@
@page "/login/verify"
@using global::Account.Client
@using global::Account.Features.EmailAuthentication.Domain
@using global::Account.Features.EmailAuthentication.Requests
@implements IDisposable
@inject EmailAuthenticationClient EmailAuthentication
@inject NavigationManager Navigation

<PageTitle>@CommonStrings.EnterYourVerificationCode</PageTitle>

<PublicNav/>

<h1>@CommonStrings.EnterYourVerificationCode</h1>

<p data-testid="verify-email">@string.Format(CultureInfo.CurrentCulture, AuthenticationStrings.CheckEmailForVerificationCode, Email)</p>

<EditForm EditContext="_editContext" FormName="login-verify" OnValidSubmit="CompleteAsync">
    <DataAnnotationsValidator/>
    <label>
        @AuthenticationStrings.LoginVerificationCode
        <InputText @bind-Value="Input.OneTimePassword" autocomplete="one-time-code" data-testid="code"/>
    </label>
    <ValidationMessage For="() => Input.OneTimePassword"/>
    <button type="submit" data-testid="submit">@AuthenticationStrings.Verify</button>
</EditForm>

<FormErrorAlert Errors="_formErrors"/>

@code {

    private EditContext _editContext = null!;
    private FormErrorMapper _formErrors = null!;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    [SupplyParameterFromForm(FormName = "login-verify")]
    // Null when the request is not this form's post; the getter then supplies an empty model
    private OneTimePasswordForm Input
    {
        get => field ??= new OneTimePasswordForm();
        set;
    }

    [SupplyParameterFromQuery]
    public string? Id { get; set; }

    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    [SupplyParameterFromQuery]
    public string? ReturnPath { get; set; }

    protected override void OnInitialized()
    {
        _editContext = new EditContext(Input);
        _formErrors = new FormErrorMapper(_editContext);
    }

    public void Dispose()
    {
        _formErrors.Dispose();
    }

    private async Task CompleteAsync()
    {
        // A missing id and one that is not an email login id are both a login that cannot be completed
        if (!EmailLoginId.TryParse(Id, out var emailLoginId))
        {
            _formErrors.AddFormMessage(AuthenticationStrings.LoginExpired);
            return;
        }

        var result = await EmailAuthentication.CompleteLoginAsync(emailLoginId, new CompleteEmailLoginCommand(Input.OneTimePassword), HttpContext.RequestAborted);
        if (!result.IsSuccess)
        {
            _formErrors.ApplyFailure(result);
            return;
        }

        Navigation.NavigateTo(AppUrls.SanitizeReturnPath(ReturnPath), true);
    }

}
