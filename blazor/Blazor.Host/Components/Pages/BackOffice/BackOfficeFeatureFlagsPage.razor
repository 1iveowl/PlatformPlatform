@* The back office's feature flag list, served only on the back-office host and only for the back-office identity the account
   API's back-office listener forwards (BackOfficeAuthentication). The page is server-rendered; the render mode is on the
   WebAssembly component it hosts, which prerenders the shell and the heading and loads the flags in the browser. *@
@page "/back-office/feature-flags"
@using Blazor.Client.BackOffice.FeatureFlags
@using Blazor.Host.Account
@using Blazor.Host.Shell
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = BackOfficeAuthentication.PolicyName)]
@attribute [BackOfficeSurface]
@inject BackOfficeSettings Settings

<PageTitle>@BackOfficeStrings.FeatureFlags</PageTitle>

<FeatureFlagsSurface IsSubscriptionEnabled="@Settings.IsSubscriptionEnabled" @rendermode="InteractiveWebAssembly"/>
