@* The back office's accounts list, served only on the back-office host and only for the back-office identity the account
   API's back-office listener forwards (BackOfficeAuthentication). The page is server-rendered; the render mode is on the
   WebAssembly component it hosts, which prerenders the shell and the list's frame and loads the rows in the browser. The
   subscription setting is the deployment's, the same for every visitor, and decides the billing menu group and banners. *@
@page "/back-office/accounts"
@using Blazor.Client.BackOffice.Accounts
@using Blazor.Host.Account
@using Blazor.Host.Shell
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = BackOfficeAuthentication.PolicyName)]
@attribute [BackOfficeSurface]
@inject BackOfficeSettings Settings

<PageTitle>@BackOfficeStrings.Accounts</PageTitle>

<AccountsSurface IsSubscriptionEnabled="@Settings.IsSubscriptionEnabled" @rendermode="InteractiveWebAssembly"/>
