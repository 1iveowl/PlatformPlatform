@* The back office's feature flag detail, served only on the back-office host and only for the back-office identity the account
   API's back-office listener forwards (BackOfficeAuthentication). The route takes one path segment, the flag's registry key as
   the React back office uses it; whether it names a flag is settled in the browser, which shows the back office's not-found
   state inside the shell for a key that names none. The page is server-rendered; the render mode is on the WebAssembly
   component it hosts, which prerenders the shell and the loading state. *@
@page "/back-office/feature-flags/{FlagKey}"
@using Blazor.Client.BackOffice.FeatureFlags
@using Blazor.Host.Account
@using Blazor.Host.Shell
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = BackOfficeAuthentication.PolicyName)]
@attribute [BackOfficeSurface]
@inject BackOfficeSettings Settings

<PageTitle>@BackOfficeStrings.FeatureFlags</PageTitle>

<FeatureFlagDetailSurface FlagKey="@FlagKey" IsSubscriptionEnabled="@Settings.IsSubscriptionEnabled" @rendermode="InteractiveWebAssembly"/>

@code {

    [Parameter]
    public string FlagKey { get; set; } = "";

}
