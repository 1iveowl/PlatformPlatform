@page "/back-office"
@using Blazor.Client.BackOffice
@using Blazor.Host.Account
@using Blazor.Host.Shell
@using Microsoft.AspNetCore.Authorization
@using SharedKernel.Authentication.BackOfficeIdentity
@* The back-office placeholder page, served only on the back-office host and only for the back-office identity the account
   API's back-office listener forwards (BackOfficeAuthentication). The name and the admin marker come from that identity;
   the admin marker is the account API's BackOfficeAdmin policy verdict, which the API still enforces on every admin call. *@
@attribute [Authorize(Policy = BackOfficeAuthentication.PolicyName)]
@attribute [BackOfficeSurface]
@inject IWebHostEnvironment Environment

<PageTitle>@BackOfficeStrings.BackOffice</PageTitle>

<main>
    <h1>@BackOfficeStrings.BackOffice</h1>
    <p>
        @BackOfficeStrings.SignedInAs <span data-testid="back-office-name">@_name</span>
    </p>
    <p data-testid="back-office-admin-marker">@(_isAdmin ? BackOfficeStrings.Admin : BackOfficeStrings.NotAdmin)</p>

    <BackOfficeIdentityCheck ShowDevelopmentCheck="@Environment.IsDevelopment()" @rendermode="InteractiveWebAssembly"/>
</main>

@code {

    private bool _isAdmin;
    private string _name = "";

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = null!;

    protected override void OnInitialized()
    {
        _name = HttpContext.User.Identity?.Name ?? "";
        _isAdmin = HttpContext.User.HasClaim(ForwardedBackOfficeIdentity.AdminClaimType, "true");
    }

}
