@* The back office's home, the dashboard, served only on the back-office host and only for the back-office identity the
   account API's back-office listener forwards (BackOfficeAuthentication). The page is server-rendered; the render mode is on
   the WebAssembly component it hosts, which prerenders the shell and the dashboard's frame and loads the data in the
   browser. The subscription setting is the deployment's, the same for every visitor. *@
@page "/back-office"
@using Blazor.Client.BackOffice.Dashboard
@using Blazor.Host.Account
@using Blazor.Host.Shell
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Policy = BackOfficeAuthentication.PolicyName)]
@attribute [BackOfficeSurface]
@inject BackOfficeSettings Settings

<PageTitle>@BackOfficeStrings.Dashboard</PageTitle>

<BackOfficeDashboard IsSubscriptionEnabled="@Settings.IsSubscriptionEnabled" @rendermode="InteractiveWebAssembly"/>
