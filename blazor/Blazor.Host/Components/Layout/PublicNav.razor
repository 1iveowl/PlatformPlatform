@* Navigation for the static server-rendered public surface. Links inside the public surface use enhanced navigation; the
   link into the authenticated surface opts out, so crossing the authentication boundary is a full document load. *@
<nav data-testid="public-nav">
    <a href="@AppUrls.ToAbsolute("")" data-testid="nav-landing">Home</a> |
    <a href="@AppUrls.ToAbsolute("login")" data-testid="nav-login">Log in</a> |
    <a href="@AppUrls.ToAbsolute("signup")" data-testid="nav-signup">Sign up</a> |
    <a href="@AppUrls.ToAbsolute("legal/terms")" data-testid="nav-terms">Terms</a> |
    <a href="@AppUrls.AuthenticatedHome" data-enhance-nav="false" data-testid="nav-app">Open the app</a>
</nav>
