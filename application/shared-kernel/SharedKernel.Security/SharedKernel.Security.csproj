<!--
    The security primitives a host needs to trust the platform's tokens and share its data protection key ring, without the
    database, repository, messaging or telemetry registrations in SharedKernel. SharedKernel and the Blazor host both
    reference it, so every host validates tokens and protects data the same way.
-->
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Library</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>SharedKernel.Security</AssemblyName>
        <RootNamespace>SharedKernel</RootNamespace>
        <!-- DevelopmentTokenSigningClient reads the signing key from the user secrets store of its own assembly, which is the
             store the AppHost writes -->
        <UserSecretsId>platformplatform-f817f2a1-ac57-4756-aef2-a57ca864bbd3</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <!-- Inherited global usings for packages and namespaces this assembly does not reference -->
        <Using Remove="JetBrains.Annotations"/>
        <Using Remove="MediatR"/>
        <Using Remove="SharedKernel.StronglyTypedIds"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Azure.Identity"/>
        <PackageReference Include="Azure.Security.KeyVault.Keys"/>
        <PackageReference Include="Azure.Security.KeyVault.Secrets"/>
        <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer"/>
    </ItemGroup>

</Project>
