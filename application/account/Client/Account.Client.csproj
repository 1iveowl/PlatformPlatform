<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <AssemblyName>Account.Client</AssemblyName>
        <RootNamespace>Account.Client</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Inherited server-only global usings that a portable assembly must not depend on -->
        <Using Remove="MediatR"/>
        <Using Remove="Microsoft.Extensions.Logging"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Contracts\Account.Contracts.csproj"/>
    </ItemGroup>

</Project>
