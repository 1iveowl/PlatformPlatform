@* The code that completes a login the recipient started in a browser. *@
@inject EmailBrand Brand

<EmailLayout Subject="@EmailText.Format(EmailStrings.LoginVerificationCodeSubject, Brand.ProductName)"
             OneTimePassword="@Model.OneTimePassword"
             Domain="@Model.Domain">
    <EmailHeading>@EmailStrings.ConfirmationCodeBelowHeading</EmailHeading>
    <EmailParagraph>@EmailStrings.EnterCodeInOpenBrowserWindow</EmailParagraph>
    <OneTimePasswordSection OneTimePassword="@Model.OneTimePassword"/>
    <EmailMutedParagraph>@EmailStrings.IgnoreEmailIfNoLoginAttempt</EmailMutedParagraph>
</EmailLayout>

@code {

    [Parameter]
    [EditorRequired]
    public required StartLoginEmailModel Model { get; set; }

}
