@* The boxed one-time password, in a monospaced face wide enough to read a character at a time. *@
<table align="center" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" class="email-otp-box" style="margin:16px 0;border-radius:8px;background-color:#f1f5f9;padding:16px;text-align:center">
    <tbody>
    <tr>
        <td>
            <p class="email-otp-text" style="font-size:32px;line-height:24px;margin:0;text-align:center;font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,'Liberation Mono','Courier New',monospace;letter-spacing:8px;color:#0f172a">@OneTimePassword</p>
        </td>
    </tr>
    </tbody>
</table>

@code {

    [Parameter]
    [EditorRequired]
    public required string OneTimePassword { get; set; }

}
