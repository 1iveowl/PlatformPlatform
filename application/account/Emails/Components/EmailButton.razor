@* The single call to action of an email, as a link styled to read as a button in clients that keep the inline styles. *@
<table align="center" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="margin-top:24px;text-align:center">
    <tbody>
    <tr>
        <td>
            <a href="@Href" class="email-button-default" style="display:inline-block;border-radius:8px;background-color:#0f172a;padding:12px 24px;font-size:14px;font-weight:500;color:#ffffff;text-decoration:none" target="_blank">@ChildContent</a>
        </td>
    </tr>
    </tbody>
</table>

@code {

    [Parameter]
    [EditorRequired]
    public required string Href { get; set; }

    [Parameter]
    [EditorRequired]
    public required RenderFragment ChildContent { get; set; }

}
