@* The frame every transactional email shares: the head with the subject and the stylesheet, the brand banner, the white
   card holding the email's own content, the brand and legal footer, and for an email carrying a one-time password the
   hidden autofill line. Tables and inline styles rather than modern layout, because that is what mail clients render. *@
@inject EmailBrand Brand

@((MarkupString)EmailDocument.DocumentType)
<html dir="ltr" lang="@CultureInfo.CurrentUICulture.Name">
<head>
    <link rel="preload" as="image" href="@Brand.LogoUrl"/>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type"/>
    <meta name="x-apple-disable-message-reformatting"/>
    <meta name="color-scheme" content="light dark"/>
    <meta name="supported-color-schemes" content="light dark"/>
    <title>@Subject</title>
    <style>@((MarkupString)EmailDocument.BuildStyleSheet(Brand.HeaderBackground))</style>
</head>
<body class="email-body" style="background-color:#f4f4f5;margin:0;padding:0">
<div style="display:none;overflow:hidden;line-height:1px;opacity:0;max-height:0;max-width:0">@Subject</div>
<table border="0" width="100%" cellpadding="0" cellspacing="0" role="presentation" align="center">
    <tbody>
    <tr>
        <td style="margin:0;background-color:#f4f4f5;padding:0;color:#0f172a;font-family:@EmailDocument.FontStack">
            <table align="center" width="100%" class="email-card" border="0" cellpadding="0" cellspacing="0" role="presentation" style="max-width:600px;margin:40px auto 24px auto;width:100%;overflow:hidden;border-radius:12px;background-color:#ffffff">
                <tbody>
                <tr style="width:100%">
                    <td>
                        <table align="center" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" class="email-header" style="background-color:@Brand.HeaderBackground">
                            <tbody>
                            <tr>
                                <td><img alt="@Brand.ProductName" src="@Brand.LogoUrl" width="600" style="display:block;outline:none;border:none;text-decoration:none;width:100%;max-width:600px;height:auto"/></td>
                            </tr>
                            </tbody>
                        </table>
                        <table align="center" width="100%" border="0" cellpadding="0" cellspacing="0" role="presentation" style="padding:32px">
                            <tbody>
                            <tr>
                                <td>@ChildContent</td>
                            </tr>
                            </tbody>
                        </table>
                    </td>
                </tr>
                </tbody>
            </table>
            <EmailFooter/>
            @if (OneTimePassword is not null && Domain is not null)
            {
                <div aria-hidden="true" style="display:none">@EmailPlainTextBuilder.OneTimePasswordAutofillLine(Domain, OneTimePassword)</div>
            }
        </td>
    </tr>
    </tbody>
</table>
</body>
</html>

@code {

    [Parameter]
    [EditorRequired]
    public required string Subject { get; set; }

    [Parameter]
    [EditorRequired]
    public required RenderFragment ChildContent { get; set; }

    [Parameter]
    public string? OneTimePassword { get; set; }

    [Parameter]
    public string? Domain { get; set; }

}
